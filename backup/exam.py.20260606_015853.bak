@router.callback_query(F.data.startswith("toggle_setting_"))
async def toggle_settings_handler(callback: CallbackQuery):
    raw = callback.data.replace("toggle_setting_", "")
    parts = raw.rsplit("_", 1)
    subject = parts[0]
    setting_type = parts[1]
    
    user_id = callback.from_user.id
    settings = practice_settings.setdefault(user_id, {
        "review_type": "course",
        "correction_style": "immediate",
        "chrono_seconds": 0,
        "question_filter": "all",
        "question_source": "official",
        "question_count": "all",
    })
    
    if setting_type == "review":
        settings["review_type"] = "theme" if settings.get("review_type") == "course" else "course"
    elif setting_type == "correct":
        settings["correction_style"] = "end" if settings.get("correction_style") == "immediate" else "immediate"
    elif setting_type == "chrono":
        chrono_sec = settings.get("chrono_seconds", 0)
        if chrono_sec == 0:
            settings["chrono_seconds"] = 30
        elif chrono_sec == 30:
            settings["chrono_seconds"] = 60
        else:
            settings["chrono_seconds"] = 0
    elif setting_type == "count":
        q_count = settings.get("question_count", "all")
        try:
            q_count = int(q_count)
        except ValueError:
            q_count = "all"
        if q_count == "all":
            settings["question_count"] = 5
        elif q_count == 5:
            settings["question_count"] = 10
        elif q_count == 10:
            settings["question_count"] = 20
        else:
            settings["question_count"] = "all"
    elif setting_type == "filter":
        settings["question_filter"] = "errors" if settings.get("question_filter") == "all" else "all"
    elif setting_type == "source":
        curr = settings.get("question_source", "official")
        if curr == "official":
            settings["question_source"] = "community"
        elif curr == "community":
            settings["question_source"] = "ai"
        else:
            settings["question_source"] = "official"
        
    await callback.answer("🔄 تم التعديل !")
    await callback.message.edit_reply_markup(
        reply_markup=customize_settings_kb(subject, settings)
    )


