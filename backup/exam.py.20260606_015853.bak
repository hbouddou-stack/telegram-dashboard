@router.callback_query(F.data.startswith("ai_test_"))
async def ai_test_subject_selected(callback: CallbackQuery):
    subject = callback.data.replace("ai_test_", "").lower().strip()
    questions = await merged_for_ai(subject)
    if not questions:
        all_ai = await merged_for_ai()
        available = set(q['subject'] for q in all_ai)
        if not available:
            await callback.answer("⚠️ لا توجد أسئلة ذكاء اصطناعي حالياً. يرجى المزامنة من لوحة الإدارة.", show_alert=True)
        else:
            names = [subject_name(s) for s in available]
            await callback.answer(f"⚠️ هذه المادة فارغة حالياً.\nالمواد المتوفرة: {', '.join(names)}", show_alert=True)
        return
        
    context = f"ai_{subject}"
    await callback.message.edit_text(
        f"🧪 {subject_name(subject)} (أسئلة AI)\n"
        f"❓ إجمالي الأسئلة المتاحة: {len(questions)}\n\n"
        "اختر عدد الأسئلة:",
        reply_markup=question_count_kb(context)
    )

