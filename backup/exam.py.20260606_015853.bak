@router.callback_query(F.data.startswith("qcount_ai_"))
async def ai_exam_start(callback: CallbackQuery):
    # Format: qcount_ai_{subject}_{count}
    parts = callback.data.split("_")
    subject = parts[2]
    count_str = parts[3]
    
    from question_pool import merged_for_ai
    questions = await merged_for_ai(subject)
    
    if not questions:
        await callback.answer("⚠️ لا توجد أسئلة لهذه المادة حالياً.")
        return
        
    random.shuffle(questions)
    count = parse_count(count_str, len(questions))
    questions = questions[:count]
    
    user_id = callback.from_user.id
    exam_sessions[user_id] = {
        "questions":        questions,
        "index":            0,
        "current_idx":      0,
        "correct":          0,
        "wrong":            0,
        "mode":             "training", # Correction immédiate
        "start_time":       time.time(),
        "answered":         set(),
        "subject":          subject,
        "answers":          {},
    }
    
    await callback.answer("🚀 بدأ اختبار الذكاء الاصطناعي!")
    await _send_question(callback, user_id)


