@router.callback_query(F.data.startswith("qdirect_"))
async def quick_direct_count(callback: CallbackQuery):
    # Format possible : qdirect_{count}_{subject}  OU  qdirect_{count}_training_{subject}
    parts = callback.data.split("_")
    if len(parts) < 3:
        return
        
    count_str = parts[1]
    
    # Détection du mode et du sujet
    if "training" in callback.data:
        mode = "training"
        # parts[2] est "training", parts[3] est le sujet
        subject = parts[3] if len(parts) > 3 else "fiqh"
    else:
        mode = "exam"
        subject = parts[2]
        
    questions = await merged_for_subject(subject)
    if not questions:
        await callback.answer("⚠️ لا توجد أسئلة متاحة!")
        return
        
    random.shuffle(questions)
    count = parse_count(count_str, len(questions))
    questions = questions[:count]
    
    user_id = callback.from_user.id
    exam_sessions[user_id] = {
        "questions":        questions,
        "index":            0,
        "current_idx":      0,
        "correct":          0,
        "wrong":            0,
        "mode":             mode,
        "start_time":       time.time(),
        "answered":         set(),
        "subject":          subject,
        "answers":          {},
    }
    
    msg = "💪 انطلاق التدريب!" if mode == "training" else "📝 انطلاق الامتحان!"
    await callback.answer(msg)
    await _send_question(callback, user_id)


