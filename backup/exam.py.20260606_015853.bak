@router.callback_query(F.data.startswith("start_practice_"))
async def start_practice_handler(callback: CallbackQuery):
    subject = callback.data.replace("start_practice_", "")
    user_id = callback.from_user.id
    settings = practice_settings.setdefault(user_id, {
        "review_type": "course",
        "correction_style": "immediate",
        "chrono_seconds": 0,
        "question_filter": "all",
        "question_source": "official",
        "question_count": "all",
    })
    
    if settings.get("question_filter") == "errors":
        await launch_practice_direct(callback, subject, f"subj_{subject}", settings)
        return
        
    if settings.get("review_type") == "theme":
        topic_selections[user_id] = {
            "subject": subject, 
            "selected": set(), 
            "mode": "topic",
            "is_training": True
        }
        await callback.message.edit_text(
            f"🎯 {subject_name(subject)} — اختر المواضيع للمراجعة :",
            reply_markup=topic_multi_select_kb(f"train_{subject}", set())
        )
    else:
        topic_selections[user_id] = {
            "subject": subject, 
            "selected": set(), 
            "mode": "number",
            "is_training": True
        }
        nums = NUMBERS_BY_SUBJECT.get(subject, [])
        await callback.message.edit_text(
            f"🔢 {subject_name(subject)} — اختر أرقام الدروس للتدريب :",
            reply_markup=course_number_multi_select_kb(f"train_{subject}", set(), nums)
        )


