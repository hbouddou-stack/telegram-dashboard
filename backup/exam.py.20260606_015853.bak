# ── اختيار حسب السنة الهجرية (السيرة النبوية) ──────────────────────────────────

async def get_questions_for_hijra_year(year: int) -> list:
    import json
    import os
    mapping_path = "lessons/sira_lessons_mapping.json"
    courses = []
    if os.path.exists(mapping_path):
        try:
            with open(mapping_path, "r", encoding="utf-8") as f:
                mapping = json.load(f).get("sira", {})
                for cn_str, info in mapping.items():
                    if year in info.get("years_hijra", []):
                        courses.append(int(cn_str))
        except Exception as e:
            print(f"Error reading Sira lessons mapping: {e}")
            
    if not courses:
        hardcoded = {
            2: [14, 15],
            3: [15, 16],
            4: [16, 17],
            5: [18],
            6: [18, 19],
            7: [19, 20],
            8: [20, 21],
            9: [21],
            10: [21, 22]
        }
        courses = hardcoded.get(year, [])

    from question_pool import get_merged_pool
    pool = await get_merged_pool()
    
    matched_questions = []
    for q in pool:
        if q.get("subject") == "sira" and q.get("course_number") in courses:
            q_year = q.get("hijra_year")
            
            # Find how many years this question's course covers
            cn_str = str(q.get("course_number"))
            course_years = []
            if os.path.exists(mapping_path):
                try:
                    with open(mapping_path, "r", encoding="utf-8") as f:
                        course_years = json.load(f).get("sira", {}).get(cn_str, {}).get("years_hijra", [])
                except Exception:
                    pass
            if not course_years:
                c_years_map = {
                    14: [2],
                    15: [2, 3],
                    16: [3, 4],
                    17: [4],
                    18: [5, 6],
                    19: [6, 7],
                    20: [7, 8],
                    21: [8, 9, 10],
                    22: [10]
                }
                course_years = c_years_map.get(q.get("course_number"), [])
                
            if len(course_years) > 1:
                if q_year == year:
                    matched_questions.append(q)
            else:
                if year in course_years:
                    matched_questions.append(q)
                    
    return matched_questions


