def format_explanation_html(explanation: str) -> str:
    if not explanation:
        return ""
    
    # Remplacement de "قول الشيخ" par "الشيخ ياسين العمري يقول" pour homogénéité
    explanation = explanation.replace("قول الشيخ ياسين العمري", "الشيخ ياسين العمري يقول :")
    explanation = explanation.replace("📖 <b>قول الشيخ ياسين العمري</b> :", "📖 <b>الشيخ ياسين العمري يقول :</b>")
    explanation = explanation.replace("📖 <b>قول الشيخ ياسين العمري</b>", "📖 <b>الشيخ ياسين العمري يقول :</b>")
    explanation = explanation.replace("📖 <b>قول الشيخ ياسين العمري :</b>", "📖 <b>الشيخ ياسين العمري يقول :</b>")
    
    # Force RTL mark
    explanation = "\u200f" + explanation.strip()
    
    # If "💡 <b>التفسير التربوي</b> :" is present
    if "💡 <b>التفسير التربوي</b> :" in explanation:
        parts = explanation.split("💡 <b>التفسير التربوي</b> :", 1)
        before = parts[0]
        after_title = parts[1]
        
        # On cherche la mention du Sheikh pour séparer
        if "📖 <b>الشيخ ياسين العمري يقول" in after_title:
            subparts = after_title.split("📖 <b>الشيخ ياسين العمري يقول", 1)
            pedagogical_text = subparts[0].strip()
            rest = "📖 <b>الشيخ ياسين العمري يقول" + subparts[1]
            
            # Format en blockquote (avec le trait bleu à gauche dans Telegram)
            formatted_pedagogical = f"<blockquote>\u200f{pedagogical_text}</blockquote>"
            explanation = f"{before}💡 <b>التفسير التربوي</b> :\n{formatted_pedagogical}\n\n\u200f{rest}"
        elif "الشيخ ياسين العمري يقول" in after_title:
            subparts = after_title.split("الشيخ ياسين العمري يقول", 1)
            pedagogical_text = subparts[0].strip()
            rest = "الشيخ ياسين العمري يقول" + subparts[1]
            
            # Format en blockquote
            formatted_pedagogical = f"<blockquote>\u200f{pedagogical_text}</blockquote>"
            explanation = f"{before}💡 <b>التفسير التربوي</b> :\n{formatted_pedagogical}\n\n\u200f{rest}"
        else:
            pedagogical_text = after_title.strip()
            formatted_pedagogical = f"<blockquote>\u200f{pedagogical_text}</blockquote>"
            explanation = f"{before}💡 <b>التفسير التربوي</b> :\n{formatted_pedagogical}"
            
    return explanation



@router.message(F.text == "/reload_curriculum")
async def reload_curr_cmd(message: Message, state: FSMContext):
    if not await auth.is_any_admin(message.from_user.id):
        return
    await state.clear()
    from data.data_manager import reload_curriculum
    await reload_curriculum()
    await message.answer("✅ تم إعادة تحميل المناهج والبيانات بنجاح!")

@router.message(F.text == "/debug_curriculum")
async def debug_curriculum(message: Message):
    if not await auth.is_any_admin(message.from_user.id):
        return
    
    msg = "📊 **Curriculum Debug**\n\n"
    msg += "🔢 **Numbers:**\n"
    for s, nums in NUMBERS_BY_SUBJECT.items():
        msg += f"- {s}: {nums}\n"
    
    msg += "\n📚 **Topics:**\n"
    for s, topics in TOPICS_BY_SUBJECT.items():
        msg += f"- {s}: {len(topics)} topics\n"
        
    await message.answer(msg)

