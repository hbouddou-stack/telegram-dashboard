def _cancel_chrono_task(user_id: int):
    task = chrono_tasks.pop(user_id, None)
    if task and not task.done():
        task.cancel()


# ── Helper: Créer les boutons de réponse en 2 colonnes ─────────────────────────

def _build_answer_buttons(q_id: int, choices: dict, is_exam_mode: bool = False, 
                          is_answered: bool = False, chosen: str = None) -> list:
    """
    Crée les boutons de réponse (2 par ligne) + boutons action.
    Retourne une liste de listes d'InlineKeyboardButton.
    """
    rows = []
    items = list(choices.items())
    
    # Réponses 1 par ligne (pour éviter les textes coupés)
    for letter, text in items:
        if is_exam_mode and is_answered and letter == chosen:
            btn_text = f"✓ {letter}. {text}"
        else:
            btn_text = f"{letter}. {text}"
        rows.append([InlineKeyboardButton(
            text=btn_text,
            callback_data=f"answer_{q_id}_{letter}"
        )])
    
    # Boutons action (Signaler + Favoris)
    rows.append([
        InlineKeyboardButton(text="📮 إبلاغ",             callback_data=f"report_q_id:{q_id}"),
        InlineKeyboardButton(text="⭐ أسئلتي المفضلة",    callback_data=f"fav_add_{q_id}"),
    ])
    
    return rows


async def _chrono_auto_skip(user_id: int, bot, chat_id: int, message_id: int, seconds: int):
    """Tâche de fond: passe automatiquement à la question suivante si pas de réponse."""
    try:
        await asyncio.sleep(seconds)
    except asyncio.CancelledError:
        return

    session = exam_sessions.get(user_id)
    if not session:
        return
    is_chrono = (session.get("mode") == "chrono") or (session.get("chrono_sec", 0) > 0)
    if not is_chrono:
        return

    idx = session["index"]
    questions = session["questions"]
    if idx >= len(questions):
        return

    q = questions[idx]
    if q["id"] in session["answered"]:
        return

    session["answered"].add(q["id"])
    session["answers"][q["id"]] = None
    session["wrong"] += 1
    session["index"] += 1
    current = session["index"]
    total   = len(questions)

    try:
        if current >= total:
            result_text = _build_result_text(session)
            await _finalize_exam(user_id, bot, chat_id)
            await bot.edit_message_text(
                f"⏰ انتهى وقت آخر سؤال!\n\n🏁 انتهى الاختبار!\n{result_text}",
                chat_id=chat_id,
                message_id=message_id,
                reply_markup=end_exam_kb()
            )
        else:
            await bot.edit_message_text(
                f"⏰ انتهى الوقت! تم الانتقال تلقائياً\n"
                f"━━━━━━━━━━━━━━━━━━━━━━\n"
                f"📌 تبقى {total - current} سؤال\n\n"
                "اضغط للمتابعة ◀️",
                chat_id=chat_id,
                message_id=message_id,
                reply_markup=next_question_kb()
            )
    except Exception:
        pass


