SIRA_THEMES = [
    "الشمائل والأخلاق النبوية",
    "بيت النبوة والحياة الشخصية",
    "العبادات والتشريعات",
    "الغزوات والسرايا"
]

FIQH_THEMES = [
    "فرائض الصلاة",
    "شروط الصلاة",
    "سنن الصلاة",
    "مندوبات الصلاة",
    "مكروهات ومبطلات الصلاة",
    "صلاة الجمعة",
    "سجود السهو",
    "فرض عين / فرض كفاية",
    "شروط الإمام"
]


