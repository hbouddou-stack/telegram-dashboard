        "هل تريد البدء؟"
    ),
}


@router.callback_query(F.data.startswith("etype_"))
async def exam_type_selected(callback: CallbackQuery):
    data       = callback.data.replace("etype_", "")
    parts      = data.split("_", 1)
    mode       = parts[0]
    rest       = parts[1] if len(parts) > 1 else ""
    rest_parts = rest.split("_", 1)
    count_str  = rest_parts[0]
    scope      = rest_parts[1] if len(rest_parts) > 1 else ""

    if mode == "chrono":
        await callback.message.edit_text(
            "⏱️ التحدي بالتوقيت\n"
            "━━━━━━━━━━━━━━━━━━━━━━\n"
            "اختر الوقت المسموح به لكل سؤال:\n\n"
            "إذا انتهى الوقت ينتقل البوت تلقائياً للسؤال التالي.",
            reply_markup=chrono_time_kb(f"{count_str}_{scope}")
        )
        return

    if mode in ("normal", "training", "exam"):
        await callback.message.edit_text(
            _MODE_DESC[mode],
            reply_markup=exam_confirm_kb(mode, rest)
        )
        return

    questions = await _resolve_questions(callback, mode, scope)
    if questions is None:
        return

    count = parse_count(count_str, len(questions))
    if mode == "errors":
        random.shuffle(questions)
    questions = questions[:count]

    if not questions:
        await callback.answer("لا توجد أسئلة متاحة!")
        return

    user_id = callback.from_user.id
    exam_sessions[user_id] = {
        "questions":   questions,
        "index":       0,
        "current_idx": 0,
        "correct":     0,
        "wrong":       0,
        "mode":        mode,
        "start_time":  time.time(),
        "answered":    set(),
        "subject":     questions[0]["subject"],
        "answers":     {},
    }
    if scope.startswith("cn_"):
        # On extrait le numéro à la fin (ex: cn_sira_16 -> 16)
        raw_cn = scope.replace("cn_", "").split("_")[-1]
        exam_sessions[user_id]["course_number"] = int(raw_cn)
    await _send_question(callback, user_id)


@router.callback_query(F.data.startswith("estart_"))
async def exam_start_confirmed(callback: CallbackQuery):
    """Called after user confirms mode description — actually starts the exam."""
    data       = callback.data.replace("estart_", "")
    parts      = data.split("_", 1)
    mode       = parts[0]
    rest       = parts[1] if len(parts) > 1 else ""
    rest_parts = rest.split("_", 1)
    count_str  = rest_parts[0]
    scope      = rest_parts[1] if len(rest_parts) > 1 else ""

    questions = await _resolve_questions(callback, mode, scope)
    if questions is None:
        return

    count = parse_count(count_str, len(questions))
    questions = questions[:count]

    if not questions:
        await callback.answer("لا توجد أسئلة متاحة!")
        return

    user_id = callback.from_user.id
    exam_sessions[user_id] = {
        "questions":   questions,
        "index":       0,
        "current_idx": 0,
        "correct":     0,
        "wrong":       0,
        "mode":        mode,
        "start_time":  time.time(),
        "answered":    set(),
        "subject":     questions[0]["subject"],
        "answers":     {},
    }
    if scope.startswith("cn_"):
        # On extrait le numéro à la fin (ex: cn_sira_16 -> 16)
        raw_cn = scope.replace("cn_", "").split("_")[-1]
        exam_sessions[user_id]["course_number"] = int(raw_cn)
    elif scope.startswith("hijrayear_"):
        raw_year = scope.replace("hijrayear_", "").split("_")[-1]
        exam_sessions[user_id]["hijra_year"] = int(raw_year)
    await _send_question(callback, user_id)


# ── وضع الكرونو: اختيار الوقت ────────────────────────────────────────────────

@router.callback_query(F.data.startswith("echrono_t_"))
async def chrono_time_selected(callback: CallbackQuery):
    data  = callback.data.replace("echrono_t_", "")
    parts = data.split("_", 2)
    if len(parts) < 3:
        await callback.answer("خطأ في البيانات.")
        return
    seconds   = int(parts[0])
    count_str = parts[1]
    scope     = parts[2]

    questions = await _resolve_questions(callback, "chrono", scope)
    if questions is None:
        return
    random.shuffle(questions)
    count     = parse_count(count_str, len(questions))
    questions = questions[:count]

    if not questions:
        await callback.answer("لا توجد أسئلة متاحة!")
        return

    user_id = callback.from_user.id
    exam_sessions[user_id] = {
        "questions":        questions,
        "index":            0,
        "current_idx":      0,
        "correct":          0,
        "wrong":            0,
        "mode":             "chrono",
        "start_time":       time.time(),
        "answered":         set(),
        "subject":          questions[0]["subject"],
        "answers":          {},
        "time_per_question": seconds,
    }
    if scope.startswith("cn_"):
        # On extrait le numéro à la fin (ex: cn_sira_16 -> 16)
        raw_cn = scope.replace("cn_", "").split("_")[-1]
        exam_sessions[user_id]["course_number"] = int(raw_cn)
    elif scope.startswith("hijrayear_"):
        raw_year = scope.replace("hijrayear_", "").split("_")[-1]
        exam_sessions[user_id]["hijra_year"] = int(raw_year)
    await _send_question(callback, user_id)


# ── حل الأسئلة (مصدر الأسئلة المدمجة) ───────────────────────────────────────

async def _resolve_questions(callback: CallbackQuery, mode: str, scope: str):
    questions = []
    
    if mode == "errors":
        error_ids = await get_user_errors(callback.from_user.id)
        if not error_ids:
            await callback.answer("لا توجد أخطاء مسجلة لمراجعتها!")
            return None
        questions = await merged_for_ids(error_ids)
        
    elif scope.startswith("hijrayear_"):
        parts = scope.replace("hijrayear_", "").split("_")
        if len(parts) >= 2:
            year = int(parts[1])
        else:
            year = int(parts[0])
        questions = await get_questions_for_hijra_year(year)

    elif scope.startswith("cn_"):
        parts = scope.replace("cn_", "").split("_")
        if len(parts) >= 2:
            subject = parts[0]
            cn = int(parts[1])
        else:
            cn = int(parts[0])
            user_id = callback.from_user.id
            subject = topic_selections.get(user_id, {}).get("subject")
        questions = await merged_for_course(cn, subject=subject)
        
    elif scope.startswith("range_"):
        parts = scope.replace("range_", "").split("_")
        if len(parts) >= 3:
            subject = parts[0]
            from_cn = int(parts[1])
            to_cn   = int(parts[2])
        else:
            from_cn = int(parts[0])
            to_cn   = int(parts[1])
            user_id = callback.from_user.id
            subject = topic_selections.get(user_id, {}).get("subject")
        questions = await merged_for_course_range(from_cn, to_cn, subject=subject)
        
    elif scope.startswith("subj_"):
        subject = scope.replace("subj_", "")
        questions = await merged_for_subject(subject)
        
    elif scope == "session_number" or scope == "train_session_number":
        sel = topic_selections.get(callback.from_user.id, {})
        subject = sel.get("subject")
        cns = list(sel.get("selected", []))
        questions = await merged_for_courses(cns, subject=subject) if cns else []
        
    elif scope == "session_topic" or scope == "train_session_topic":
        sel = topic_selections.get(callback.from_user.id, {})
        subject = sel.get("subject")
        names = list(sel.get("selected", []))
        questions = await merged_for_topics(subject, names) if subject and names else []
        
    elif scope == "session_theme" or scope == "train_session_theme":
        sel = topic_selections.get(callback.from_user.id, {})
        subject = sel.get("subject")
        themes = list(sel.get("selected", []))
        from question_pool import merged_for_themes
        questions = await merged_for_themes(subject, themes) if subject and themes else []
        
    elif scope.startswith("ai_"):
        subject = scope.replace("ai_", "")
        questions = await merged_for_ai(subject)
        
    else:
        await callback.answer("نطاق غير صحيح.")
        return None

    # Filtrage par source (Officiel vs Communautaire) uniquement en mode entraînement (si configuré)
    if questions:
        user_id = callback.from_user.id
        settings = practice_settings.get(user_id, {})
        q_source = settings.get("question_source", "official")
        
        if q_source == "community":
            questions = [q for q in questions if q.get("source") in ("contribution", "remarkable")]
        elif q_source == "ai":
            questions = [q for q in questions if q.get("source") == "ai"]
        else:
            # L'option "Officiel" regroupe le socle officiel et les questions générées/approuvées par l'administration
            questions = [q for q in questions if q.get("source") in ("official", "ai")]
            
        # Exclusion des questions signalées par cet utilisateur
        from database.feedback import get_user_reported_question_ids
        reported_ids = await get_user_reported_question_ids(user_id)
        if reported_ids:
            questions = [q for q in questions if q.get("id") not in reported_ids]
            
    return questions


# ── دورة الأسئلة ─────────────────────────────────────────────────────────────

def _source_line(q: dict) -> str:
    """Return a compact badge line for the question's source."""
    source = q.get("source", "official")
    badge  = SOURCE_BADGE.get(source, "🏛️")
    label  = SOURCE_LABEL.get(source, "")
    return f"{badge} {label}  "


async def _send_question(callback: CallbackQuery, user_id: int):
    session = exam_sessions.get(user_id)
    if not session:
        await callback.message.edit_text("انتهى الاختبار.", reply_markup=main_menu_kb())
        return

    # Delete any active explanation message to keep the chat clean
    expl_msg_id = session.pop("explanation_message_id", None)
    if expl_msg_id:
        try:
            await callback.bot.delete_message(chat_id=callback.message.chat.id, message_id=expl_msg_id)
        except Exception:
            pass

    mode      = session["mode"]
    questions = session["questions"]
    total     = len(questions)

    # ── وضع الامتحان الرسمي — تنقل حر ────────────────────────────────────────
    if mode == "exam":
        idx = session.get("current_idx", 0)
        idx = max(0, min(idx, total - 1))
        session["current_idx"] = idx
        q             = questions[idx]
        is_answered   = q["id"] in session["answered"]
        chosen        = session["answers"].get(q["id"])
        answered_count = len(session["answered"])
        src_line      = _source_line(q)
        note = f"\u200f✏️ إجابتك: {chosen} — يمكنك تغييرها\n" if is_answered else "\u200f👆 اختر إجابتك:\n"
        
        # Adding the question text inside a beautiful RTL blockquote inside the message text
        question_quote = f"\n\u200f<blockquote><b>❓ السؤال:</b>\n{q['question']}</blockquote>"
        
        text = (
            f"\u200f📝 الامتحان التجريبي  |  {src_line}\n"
            f"\u200f━━━━━━━━━━━━━━━━━━━━━━\n"
            f"\u200fالسؤال {idx + 1} من {total}  |  أجبت على: {answered_count}/{total}\n"
            f"{note}"
            f"\u200f━━━━━━━━━━━━━━━━━━━━━━\n"
            f"{question_quote}"
        )
        if _should_use_letter_buttons(q["choices"]):
            ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
            choices_text = ""
            for letter, choice_val in q["choices"].items():
                ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
                choices_text += f"\n\u200f<b>{ar_letter} -</b> {choice_val}"
            text += f"\n{choices_text}"

        # استخدام الدالة الجديدة لعرض السؤال في زر كبير + الإجابات
        answer_buttons = _exam_answer_buttons_only(
            q["id"], q["choices"], idx, total, answered_count, is_answered, chosen
        )
        keyboard = make_question_display_kb(q['question'], answer_buttons)
        # إضافة المعلومات قبل la keyboard
        await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")
        return

    # ── الأوضاع الأخرى (عادي / كرونو / عشوائي / مراجعة) ─────────────────────
    idx = session["index"]
    if idx >= total:
        await _show_results(callback, user_id)
        return

    q         = questions[idx]
    src_line  = _source_line(q)
    time_info = ""
    chrono_sec = session.get("chrono_sec", 0)
    if mode == "chrono" or chrono_sec > 0:
        seconds = chrono_sec if chrono_sec > 0 else session.get("time_per_question", 30)
        time_info = f"\u200f⏱️ مهلتك: {seconds} ثانية لهذا السؤال\n"

    course_info = f"📖 الدرس {q['course_number']}  |  " if "course_number" in q else ""
    
    # Adding the question text inside a beautiful RTL blockquote inside the message text
    question_quote = f"\n\u200f<blockquote><b>❓ السؤال:</b>\n{q['question']}</blockquote>"
    
    text = (
        f"\u200f📝 السؤال {idx + 1} من {total}  |  {course_info}{src_line}\n"
        f"{time_info}"
        f"{question_quote}"
    )
    if _should_use_letter_buttons(q["choices"]):
        ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
        choices_text = ""
        for letter, choice_val in q["choices"].items():
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            choices_text += f"\n\u200f<b>{ar_letter} -</b> {choice_val}"
        text += f"\n{choices_text}"
    
    # استخدام la nouvelle fonction pour afficher la question dans un gros bouton
    answer_buttons = _answer_buttons_only(q["id"], q["choices"])
    keyboard = make_question_display_kb(q['question'], answer_buttons)
    await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")

    # ── وضع الكرونو: إطلاق مؤقت الوقت ───────────────────────────────────────
    if mode == "chrono" or chrono_sec > 0:
        seconds = chrono_sec if chrono_sec > 0 else session.get("time_per_question", 30)
        _cancel_chrono_task(user_id)
        task = asyncio.create_task(
            _chrono_auto_skip(
                user_id, callback.bot,
                callback.message.chat.id,
                callback.message.message_id,
                seconds
            )
        )
        chrono_tasks[user_id] = task


# ── معالج الإجابات ────────────────────────────────────────────────────────────

@router.callback_query(F.data.startswith("answer_"))
async def handle_answer(callback: CallbackQuery):
    try:
        parts  = callback.data.split("_")
        q_id   = int(parts[1])
        chosen = parts[2].upper().strip()

        user_id = callback.from_user.id
        session = exam_sessions.get(user_id)
        if not session:
            await callback.answer("لا يوجد اختبار نشط.")
            return

        mode = session["mode"]

        q = next((qq for qq in session["questions"] if qq["id"] == q_id), None)
        if not q:
            await callback.answer("خطأ في السؤال.")
            return

        if q_id in session["answered"]:
            if mode == "exam":
                old_chosen = session["answers"].get(q_id)
                if old_chosen == q["correct"]:
                    session["correct"] -= 1
                else:
                    session["wrong"] -= 1
                session["answered"].discard(q_id)
            else:
                await callback.answer("لقد أجبت على هذا السؤال بالفعل!")
                return

        # Acknowledge the callback query instantly to remove loading spinners
        await callback.answer()

        if mode == "chrono":
            _cancel_chrono_task(user_id)

        session["answered"].add(q_id)
        session["answers"][q_id] = chosen

        correct      = q["correct"].upper().strip()
        correct_text = q["choices"].get(correct, "???")
        explanation  = q.get("explanation", "")

        if chosen == correct:
            session["correct"] += 1
            await clear_user_error(user_id, q_id)
            await record_correct_answer(user_id, q_id)
        else:
            session["wrong"] += 1
            await save_user_error(user_id, q_id, q["subject"], chosen)

        # ── Mode Sévère : Pas de correction immédiate, on passe à la suite ───
        if mode == "severe":
            session["index"] += 1
            current = session["index"]
            total   = len(session["questions"])
            
            if current >= total:
                # Préparer la session de révision avant de finaliser
                review_sessions[user_id] = {
                    "questions": list(session["questions"]),
                    "answers":   dict(session["answers"]),
                    "index":     0,
                }
                await _show_results(callback, user_id)
            else:
                await _send_question(callback, user_id)
            return

        # ── وضع الامتحان الرسمي — يبقى على نفس السؤال ────────────────────────────
        if mode == "exam":
            current_idx    = session.get("current_idx", 0)
            answered_count = len(session["answered"])
            total          = len(session["questions"])
            src_line       = _source_line(q)
            note = f"\u200f✏️ إجابتك: {chosen} — يمكنك تغييرها\n"
            question_quote = f"\n\u200f<blockquote><b>❓ السؤال:</b>\n{q['question']}</blockquote>"
            text = (
                f"\u200f📝 الامتحان التجريبي  |  {src_line}\n"
                f"\u200f━━━━━━━━━━━━━━━━━━━━━━\n"
                f"\u200fالسؤال {current_idx + 1} من {total}  |  أجبت على: {answered_count}/{total}\n"
                f"{note}"
                f"\u200f━━━━━━━━━━━━━━━━━━━━━━\n"
                f"{question_quote}"
            )
            if _should_use_letter_buttons(q["choices"]):
                ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
                choices_text = ""
                for letter, choice_val in q["choices"].items():
                    ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
                    choices_text += f"\n\u200f<b>{ar_letter} -</b> {choice_val}"
                text += f"\n{choices_text}"

            await callback.message.edit_text(
                text,
                reply_markup=exam_question_nav_kb(
                    q_id, q["choices"], current_idx, total, answered_count, True, chosen
                ),
                parse_mode="HTML"
            )
            return

        # ── الأوضاع العادية — التصحيح الفوري ────────────────────────────────────
        session["index"] += 1
        current = session["index"]
        total   = len(session["questions"])

        user   = await get_user(user_id)
        gender = user["gender"] if user else None

        ARABIC_CHOICE = {"A": "أ", "B": "ب", "C": "ج", "D": "د"}
        correct_ar = ARABIC_CHOICE.get(correct.upper(), correct)

        if chosen == correct:
            fb = praise_message(gender)
            result_text = f"\u200f✅ {fb}"
        else:
            base = get_gender_greeting(
                gender,
                "يا أخي، للأسف الإجابة خاطئة ❌",
                "يا أختي، للأسف الإجابة خاطئة ❌",
                "للأسف الإجابة خاطئة ❌"
            )
            result_text = (
                f"\u200f{base}\n\n"
                f"\u200f<b>❓ السؤال:</b>\n"
                f"<blockquote>\u200f"
                f"{q['question']}\n\n"
                f"<b>✅ الإجابة الصحيحة:</b>\n"
                f"{correct_ar}. {correct_text}"
                f"</blockquote>"
            )

        has_expl = True
        
        # Build the text for the correction screen
        # On inclut toujours la question dans le texte pour qu'elle soit visible même en cas de bonne réponse
        if chosen == correct:
            correction_text = (
                f"{result_text}\n\n"
                f"\u200f<b>❓ السؤال:</b>\n"
                f"<blockquote>\u200f"
                f"{q['question']}\n\n"
                f"<b>✅ الإجابة الصحيحة:</b>\n{correct_ar}. {correct_text}"
                f"</blockquote>"
            )
        else:
            correction_text = result_text

        if current >= total:
            # Clean up the explanation message if it exists
            expl_msg_id = session.pop("explanation_message_id", None)
            if expl_msg_id:
                try:
                    await callback.bot.delete_message(chat_id=callback.message.chat.id, message_id=expl_msg_id)
                except Exception:
                    pass
            await _finalize_exam(user_id, callback.bot, callback.message.chat.id)
            final_text = f"{correction_text}\n\n━━━━━━━━━━━━━━━━━━━━━━\n🏁 انتهى الاختبار!"
            await callback.message.edit_text(final_text, reply_markup=end_exam_kb())
            
            # Save to history for navigation
            session.setdefault("history_screens", []).append({
                "text": final_text, "q_id": q_id, "has_expl": has_expl, "is_final": True
            })
            session["view_index"] = len(session["history_screens"]) - 1
        else:
            final_text = f"{correction_text}\n\n━━━━━━━━━━━━━━━━━━━━━━\n📌 تبقى {total - current} سؤال"
            
            # Save to history for navigation
            session.setdefault("history_screens", []).append({
                "text": final_text, "q_id": q_id, "has_expl": has_expl, "is_final": False
            })
            session["view_index"] = len(session["history_screens"]) - 1
            has_prev = session["view_index"] > 0
            
            await callback.message.edit_text(
                final_text,
                reply_markup=next_question_kb(q_id=q_id, has_explanation=has_expl, has_prev=has_prev)
            )
    except Exception as e:
        import logging
        logging.exception("Error in handle_answer")
        await callback.answer("⚠️ حدث خطأ أثناء معالجة الإجابة.")


# ── تنقل الامتحان الرسمي ─────────────────────────────────────────────────────

@router.callback_query(F.data == "exam_prev")
async def exam_nav_prev(callback: CallbackQuery):
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id)
    if not session or session["mode"] != "exam":
        await callback.answer()
        return
    idx = session.get("current_idx", 0)
    if idx > 0:
        session["current_idx"] = idx - 1
    await _send_question(callback, user_id)


@router.callback_query(F.data == "exam_next")
async def exam_nav_next(callback: CallbackQuery):
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id)
    if not session or session["mode"] != "exam":
        await callback.answer()
        return
    total = len(session["questions"])
    idx   = session.get("current_idx", 0)
    if idx < total - 1:
        session["current_idx"] = idx + 1
    await _send_question(callback, user_id)


@router.callback_query(F.data == "exam_submit")
async def exam_submit(callback: CallbackQuery):
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id)
    if not session or session["mode"] != "exam":
        await callback.answer()
        return

    answered_count = len(session["answered"])
    if answered_count == 0:
        await callback.answer("لم تُجب على أي سؤال بعد!", show_alert=True)
        return

    for q in session["questions"]:
        if q["id"] not in session["answered"]:
            session["wrong"] += 1

    review_sessions[user_id] = {
        "questions": list(session["questions"]),
        "answers":   dict(session["answers"]),
        "index":     0,
    }
    result_text = _build_result_text(session)
    await _finalize_exam(user_id, callback.bot, callback.message.chat.id)
    await callback.message.edit_text(
        f"🏁 انتهى الامتحان!\n\n{result_text}",
        reply_markup=end_exam_with_review_kb()
    )


def split_explanation(explanation_text: str):
    import re
    if not explanation_text:
        return "", "", ""
        
    text = explanation_text.strip()
    
    # 1. Split into paragraphs/blocks by looking at double newlines
    blocks = [b.strip() for b in re.split(r'\n\s*\n', text) if b.strip()]
    
    pedagogical_blocks = []
    citation_blocks = []
    source_blocks = []
    
    # Check if there is ANY citation marker or pedagogical marker in the entire text
    has_any_cit_marker = False
    has_any_ped_marker = False
    
    cit_markers = ["📖", "قول الشيخ", "الشيخ ياسين"]
    ped_markers = ["💡", "التفسير التربوي"]
    
    for m in cit_markers:
        if m in text:
            has_any_cit_marker = True
            break
            
    for m in ped_markers:
        if m in text:
            has_any_ped_marker = True
            break
            
    if not has_any_cit_marker and not has_any_ped_marker:
        return "", text, ""
        
    for block in blocks:
        is_src = False
        if block.startswith("📍") or "المصدر" in block[:40]:
            is_src = True
            
        if is_src:
            source_blocks.append(block)
            continue
            
        is_cit = False
        if block.startswith("📖") or "📖" in block[:15] or block.startswith("قول الشيخ") or "قول الشيخ" in block[:20]:
            is_cit = True
        elif "الشيخ ياسين" in block[:40] and ("يقول" in block[:60] or "العمري" in block[:50]):
            is_cit = True
            
        if is_cit:
            citation_blocks.append(block)
        else:
            pedagogical_blocks.append(block)
            
    pedagogical = "\n\n".join(pedagogical_blocks)
    citation = "\n\n".join(citation_blocks)
    source = "\n\n".join(source_blocks)
    
    # Clean pedagogical headers
    ped_prefixes = [
        r'^💡\s*',
        r'^<b>\s*(\d+\.)?\s*💡?\s*التفسير\s+التربوي\s*(:|：)?\s*</b>\s*(:|：)?\s*',
        r'^(\d+\.)?\s*💡?\s*التفسير\s+التربوي\s*(:|：)?\s*',
        r'^:\s*'
    ]
    for rx in ped_prefixes:
        pedagogical = re.sub(rx, '', pedagogical, flags=re.IGNORECASE).strip()
    pedagogical = pedagogical.replace("<blockquote>", "").replace("</blockquote>", "").strip()
    
    # Clean citation headers
    cit_prefixes = [
        r'^📖\s*',
        r'^<b>\s*(\d+\.)?\s*📖?\s*قول\s+الشيخ\s*(:|：)?\s*</b>\s*(:|：)?\s*',
        r'^<b>\s*(\d+\.)?\s*📖?\s*الشيخ\s+ياسين\s+العمري\s+يقول\s*(:|：)?\s*</b>\s*(:|：)?\s*',
        r'^<b>\s*(\d+\.)?\s*📖?\s*الشيخ\s+ياسين\s+العمري\s*</b>\s*(:|：)?\s*',
        r'^<b>\s*(\d+\.)?\s*📖?\s*الشيخ\s+ياسين\s*(:|：)?\s*</b>\s*(:|：)?\s*',
        r'^(\d+\.)?\s*📖?\s*قول\s+الشيخ\s*(:|：)?\s*',
        r'^(\d+\.)?\s*📖?\s*الشيخ\s+ياسين\s+العمري\s+يقول\s*(:|：)?\s*',
        r'^(\d+\.)?\s*📖?\s*الشيخ\s+ياسين\s*(:|：)?\s*',
        r'^:\s*'
    ]
    for rx in cit_prefixes:
        citation = re.sub(rx, '', citation, flags=re.IGNORECASE).strip()
    citation = citation.replace("<blockquote>", "").replace("</blockquote>", "").strip()
    
    # Clean source headers
    src_prefixes = [
        r'^📍\s*',
        r'^<b>\s*المصدر\s*(:|：)?\s*</b>\s*(:|：)?\s*',
        r'^المصدر\s*(:|：)?\s*',
        r'^:\s*'
    ]
    for rx in src_prefixes:
        source = re.sub(rx, '', source, flags=re.IGNORECASE).strip()
    source = source.replace("<blockquote>", "").replace("</blockquote>", "").strip()
    
    # Balance HTML tags
    def balance_html_tags(html_str: str) -> str:
        if not html_str:
            return ""
        b_open = html_str.count("<b>")
        b_close = html_str.count("</b>")
        if b_open > b_close:
            html_str = html_str + "</b>" * (b_open - b_close)
        elif b_close > b_open:
            html_str = "<b>" * (b_close - b_open) + html_str
            
        i_open = html_str.count("<i>")
        i_close = html_str.count("</i>")
        if i_open > i_close:
            html_str = html_str + "</i>" * (i_open - i_close)
        elif i_close > i_open:
            html_str = "<i>" * (i_close - i_open) + html_str
            
        a_open = html_str.count("<a ") + html_str.count("<a\n")
        a_close = html_str.count("</a>")
        if a_open > a_close:
            html_str = html_str + "</a>" * (a_open - a_close)
        elif a_close > a_open:
            html_str = "<a>" * (a_close - a_open) + html_str
            
        return html_str

    pedagogical = balance_html_tags(pedagogical)
    citation = balance_html_tags(citation)
    source = balance_html_tags(source)
    
    return pedagogical, citation, source



def highlight_keywords_in_explanation(pedagogical_text: str, question_text: str) -> str:
    import re
    cleaned_q = re.sub(r'[^\w\s]', ' ', question_text)
    words = cleaned_q.split()
    
    stopwords = {
        "في", "من", "على", "إلى", "عن", "مع", "أن", "إن", "هو", "هي", "هم", "كان", "كانت",
        "التي", "الذي", "الذين", "هذا", "هذه", "ذلك", "أو", "أم", "ثم", "بل", "لا", "ما",
        "يا", "لقد", "وقد", "حيث", "كل", "بعض", "بين", "حول", "عند", "قبل", "بعد", "تحت",
        "فوق", "مع", "كيف", "متى", "أين", "منذ", "خلال", "ضد", "نحو", "منها", "إليها", "فيها",
        "بها", "له", "لها", "lhem", "حتى", "غير", "سوى", "إلا", "الخ", "السنة", "سنة", "هجرية"
    }
    
    keywords = []
    for w in words:
        w_clean = w.strip()
        if len(w_clean) >= 3 and w_clean not in stopwords:
            keywords.append(w_clean)
            if w_clean.startswith("ال") and len(w_clean) > 4:
                keywords.append(w_clean[2:])
            else:
                keywords.append("ال" + w_clean)
                
    keywords = sorted(list(set(keywords)), key=len, reverse=True)
    
    tokens = re.split(r'(<[^>]+>)', pedagogical_text)
    for i in range(len(tokens)):
        if i % 2 == 0:
            text = tokens[i]
            for kw in keywords[:12]:
                pattern = r'(?<!\w)' + re.escape(kw) + r'(?!\w)'
                text = re.sub(pattern, f"<b>{kw}</b>", text)
            tokens[i] = text
            
    return "".join(tokens)


@router.callback_query(F.data.startswith("show_expl_"))
async def show_explanation_callback(callback: CallbackQuery):
    data = callback.data.replace("show_expl_", "")
    parts = data.split("_")
    q_id = int(parts[0])
    requested_tab = parts[1] if len(parts) > 1 else None
    
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id) or review_sessions.get(user_id)
    
    if not session:
        await callback.answer("⚠️ انتهت الجلسة.")
        return

    q = next((qq for qq in session["questions"] if qq["id"] == q_id), None)
    if not q:
        await callback.answer("⚠️ لم يتم العثور على السؤال.")
        return

    # Indiquer que l'IA cherche uniquement au premier clic
    if not requested_tab:
        await callback.answer("🔍 جاري البحث في دروس الأستاذ...", show_alert=False)

    subject = q.get("subject", "")
    course_number = q.get("course_number", 0)
    question_text = q.get("question", "")
    correct_answer_letter = q.get("correct", "A")
    correct_answer_text = q.get("choices", {}).get(correct_answer_letter, "")

    try:
        explanation = await ai_tutor.get_ai_explanation(
            q_id, question_text, correct_answer_text, subject, course_number
        )
        if not explanation or "indisponible" in explanation or "Désolé" in explanation:
            raise ValueError("AI explanation unavailable")
    except Exception as e:
        logging.warning(f"AI explanation failed for question {q_id}: {e}")
        explanation = q.get("explanation", "").strip()
        if not explanation:
            user = await get_user(user_id)
            gender = user["gender"] if user else None
            explanation = get_gender_greeting(
                gender,
                "عذرًا يا أخي، شرح الأستاذ غير متوفر حاليًا لهذا السؤال. يرجى مراجعة الدرس أو المحاولة لاحقًا 🌸",
                "عذرًا يا أختي، شرح الأستاذ غير متوفر حاليًا لهذا السؤال. يرجى مراجعة الدرس أو المحاولة لاحقًا 🌸",
                "عذرًا، شرح الأستاذ غير متوفر حاليًا لهذا السؤال. يرجى مراجعة الدرس أو المحاولة لاحقًا 🌸"
            )

    # Séparation
    pedagogical, citation, source = split_explanation(explanation)
    
    # En gras les mots clés dans l'explication
    pedagogical = highlight_keywords_in_explanation(pedagogical, question_text)

    # Décision intelligente par défaut si aucun onglet n'est cliqué
    if not requested_tab:
        total_len = len(pedagogical) + len(citation)
        if total_len > 550 or not citation:
            requested_tab = "pedago"
        else:
            requested_tab = "quote"

    # Construction du texte
    question_text_escaped = html.escape(question_text)
    qa_block = f"<blockquote>❓ <b>السؤال :</b>\n{question_text_escaped}</blockquote>"

    import re

    # Nettoyage robuste pour l'explication pédagogique
    pedago_clean = pedagogical.replace("<blockquote>", "").replace("</blockquote>", "").strip()
    pedago_clean = re.sub(r'^.*?التفسير\s*التربوي\s*(:|：)?\s*', '', pedago_clean, flags=re.IGNORECASE).strip()
    pedago_clean = re.sub(r'^(💡|💡\s*)+', '', pedago_clean).strip()
    pedago_clean = re.sub(r'^[:\s\r\n\u200f]+', '', pedago_clean).strip()
    # Supprimer toutes les balises HTML et échapper le reste pour éviter tout crash dans <code>
    pedago_clean = re.sub(r'</?[a-zA-Z][^>]*>', '', pedago_clean)
    pedago_clean = html.escape(pedago_clean)
    pedago_wrapped = f"💡 <b>التفسير التربوي :</b>\n<code>\u200f{pedago_clean}</code>"

    # Nettoyage robuste pour la citation
    cit_clean = citation.replace("<blockquote>", "").replace("</blockquote>", "").strip()
    cit_clean = re.sub(r'^.*?الشيخ\s*ياسين\s*العمري\s*يقول\s*(:|：)?\s*', '', cit_clean, flags=re.IGNORECASE).strip()
    cit_clean = re.sub(r'^(📖|📖\s*)+', '', cit_clean).strip()
    cit_clean = re.sub(r'^[:\s\r\n\u200f]+', '', cit_clean).strip()
    cit_wrapped = f"📖 <b>الشيخ ياسين العمري يقول :</b>\n<blockquote>\u200f{cit_clean}</blockquote>"

    # Extraction et nettoyage de la source
    youtube_url = None
    if source:
        yt_match = re.search(r'https?://(?:www\.)?(?:youtube\.com|youtu\.be)/[^\s\)]+', source)
        if yt_match:
            youtube_url = yt_match.group(0).strip()
            
    source_clean = source.replace("📍", "").strip()
    source_clean = re.sub(r'\[([^\]]+)\]\([^\)]+\)', r'\1', source_clean) # enlever le lien markdown
    
    if source_clean:
        # Supprimer toutes les balises HTML et échapper le reste pour <code>
        source_clean = re.sub(r'</?[a-zA-Z][^>]*>', '', source_clean)
        source_clean = html.escape(source_clean)
        source_wrapped = (
            f"📍 <b>المصدر :</b>\n"
            f"<code>\u200f{source_clean}</code>\n"
            f"💡 <i>انقر على الرابط الأزرق أو زر اليوتيوب أسفله لمشاهدة الفيديو.</i>"
        )
        if youtube_url:
            source_wrapped += f"\n🔗 <a href='{youtube_url}'>شاهد الفيديو من هنا</a>"
    else:
        source_wrapped = ""

    if requested_tab == "pedago":
        content = (
            f"{qa_block}\n\n"
            f"{pedago_wrapped}\n\n"
            f"{source_wrapped}"
        )
    else:  # quote
        if citation:
            content = (
                f"{qa_block}\n\n"
                f"{cit_wrapped}\n\n"
                f"{source_wrapped}"
            )
        else:
            content = (
                f"{qa_block}\n\n"
                f"{pedago_wrapped}\n\n"
                f"{source_wrapped}"
            )

    full_text = content

    view_idx = session.get("view_index", 0)
    has_prev = view_idx > 0

    from database import get_lesson_resources
    resources = await get_lesson_resources(subject, course_number)
    has_mind_map = bool(resources and resources.get("mind_map_file_id"))

    await callback.message.edit_text(
        text=full_text,
        parse_mode="HTML",
        link_preview_options=LinkPreviewOptions(is_disabled=True),
        reply_markup=explanation_tab_kb(
            q_id=q_id,
            active_tab=requested_tab,
            has_prev=has_prev,
            youtube_url=youtube_url,
            has_citation=bool(citation),
            has_mind_map=has_mind_map
        )
    )

@router.callback_query(F.data.startswith("show_quest_"))
async def show_question_callback(callback: CallbackQuery):
    q_id = int(callback.data.replace("show_quest_", ""))
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id) or review_sessions.get(user_id)
    
    if not session:
        await callback.answer("⚠️ انتهت الجلسة.")
        return

    # Récupérer l'écran historique actuel contenant la question et sa correction
    view_idx = session.get("view_index", 0)
    history = session.get("history_screens", [])
    
    scr = None
    if view_idx < len(history) and history[view_idx].get("q_id") == q_id:
        scr = history[view_idx]
    else:
        for idx, h in enumerate(history):
            if h.get("q_id") == q_id:
                scr = h
                session["view_index"] = idx
                break

    if not scr:
        await callback.answer("⚠️ لم يتم العثور على السؤال في السجل.")
        return

    has_prev = session.get("view_index", 0) > 0
    
    await callback.message.edit_text(
        text=scr["text"],
        parse_mode="HTML",
        link_preview_options=LinkPreviewOptions(is_disabled=True),
        reply_markup=next_question_kb(
            q_id=q_id,
            has_explanation=True,
            has_prev=has_prev
        )
    )

@router.callback_query(F.data == "delete_msg")
async def delete_msg_callback(callback: CallbackQuery):
    await callback.message.delete()


@router.callback_query(F.data == "next_q")
async def next_question(callback: CallbackQuery):
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id)
    if session and "history_screens" in session:
        view_idx = session.get("view_index", 0)
        history = session["history_screens"]
        if view_idx < len(history) - 1:
            session["view_index"] = view_idx + 1
            next_scr = history[session["view_index"]]
            has_prev = session["view_index"] > 0
            
            if next_scr.get("is_final"):
                await callback.message.edit_text(next_scr["text"], reply_markup=end_exam_kb())
            else:
                await callback.message.edit_text(
                    next_scr["text"],
                    reply_markup=next_question_kb(q_id=next_scr["q_id"], has_explanation=next_scr["has_expl"], has_prev=has_prev)
                )
            await callback.answer()
            return
            
    await _send_question(callback, user_id)


@router.callback_query(F.data == "prev_q")
async def prev_question(callback: CallbackQuery):
    user_id = callback.from_user.id
    session = exam_sessions.get(user_id)
    if not session or "history_screens" not in session:
        await callback.answer("لا يمكن الرجوع للخلف.")
        return
        
    view_idx = session.get("view_index", 0)
    if view_idx > 0:
        session["view_index"] = view_idx - 1
        prev_scr = session["history_screens"][session["view_index"]]
        has_prev = session["view_index"] > 0
        
        await callback.message.edit_text(
            prev_scr["text"],
            reply_markup=next_question_kb(q_id=prev_scr["q_id"], has_explanation=prev_scr["has_expl"], has_prev=has_prev)
        )
    await callback.answer()


@router.callback_query(F.data == "end_exam")
async def end_exam_early(callback: CallbackQuery):
    user_id = callback.from_user.id
    _cancel_chrono_task(user_id)
    session = exam_sessions.get(user_id) or review_sessions.get(user_id)
    if session:
        expl_msg_id = session.pop("explanation_message_id", None)
        if expl_msg_id:
            try:
                await callback.bot.delete_message(chat_id=callback.message.chat.id, message_id=expl_msg_id)
            except Exception:
                pass
        if user_id in exam_sessions:
            await _finalize_exam(user_id, callback.bot, callback.message.chat.id)
        elif user_id in review_sessions:
            review_sessions.pop(user_id, None)
            
    await callback.message.edit_text("🚪 تم إنهاء الاختبار مبكراً.", reply_markup=end_exam_kb())


# ── بناء نص النتيجة ──────────────────────────────────────────────────────────

def _build_result_text(session: dict) -> str:
    correct = session["correct"]
    wrong   = session["wrong"]
    total   = correct + wrong
    score   = int(score_percentage(correct, total))
    if score >= 90:   grade = "ممتاز 🌟"
    elif score >= 75: grade = "جيد جداً ✅"
    elif score >= 60: grade = "جيد 📈"
    elif score >= 50: grade = "مقبول ⚠️"
    else:             grade = "يحتاج مراجعة ❌"
    elapsed    = int(time.time() - session["start_time"])
    mins, secs = elapsed // 60, elapsed % 60
    return (
        "━━━━━━━━━━━━━━━━━━━━━━\n"
        f"❓ عدد الأسئلة: {total}\n"
        f"✅ إجابات صحيحة: {correct}\n"
        f"❌ إجابات خاطئة: {wrong}\n"
        f"📊 النتيجة: {score}%\n"
        f"🏆 التقدير: {grade}\n"
        f"⏱️ الوقت: {mins}د {secs}ث\n"
        "━━━━━━━━━━━━━━━━━━━━━━"
    )


# ── إنهاء وحفظ الاختبار ──────────────────────────────────────────────────────

async def _finalize_exam(user_id: int, bot = None, chat_id: int = None):
    _cancel_chrono_task(user_id)
    session = exam_sessions.pop(user_id, None)
    if not session:
        return
    correct = session["correct"]
    wrong   = session["wrong"]
    total   = correct + wrong
    score   = int(score_percentage(correct, total))
    subject = session.get("subject", "unknown")
    
    await save_exam_result(
        user_id,
        subject,
        session.get("mode", "normal"),
        total, correct, wrong, score
    )

    if "course_number" in session:
        await update_lesson_mastery(
            user_id,
            subject,
            session["course_number"],
            correct
        )

    if session.get("subject") == "تحدي المجتمع" and score >= 50:
        await add_bonus_points(user_id, 50)

    # Adaptation automatique du niveau si on a le bot, le chat et une matière principale valide
    if total > 0 and bot and chat_id and subject in ["fiqh", "sira", "nahw", "tajweed", "aqeeda"]:
        ratio = correct / total
        current_level = await get_user_subject_level(user_id, subject)
        new_level = current_level
        
        subjects_map = {
            "fiqh": "الفقه",
            "sira": "السيرة النبوية",
            "nahw": "علم النحو",
            "tajweed": "علم التجويد",
            "aqeeda": "العقيدة الإسلامية"
        }
        subj_name = subjects_map.get(subject, subject)
        
        user = await get_user(user_id)
        user_dict = dict(user) if user else {}
        is_female = user_dict.get("gender") == "female"
        gender_title = "أختي" if is_female else "أخي"
        first_name = user_dict.get("first_name", "الطالب")
        
        change_msg = None
        if ratio >= 0.8 and current_level < 5:
            new_level = current_level + 1
            await set_user_subject_level(user_id, subject, new_level)
            change_msg = (
                f"🚀 <b>Level Up! لقد ارتفع مستواكِ!</b> 🌟\n\n" if is_female else
                f"🚀 <b>Level Up! لقد ارتفع مستواك!</b> 🌟\n\n"
                f"<blockquote>بما أنكِ حققتِ نتيجة ممتازة ({score}%) في <b>{subj_name}</b>، فقد قمتُ برفع مستوى تمكنكِ التلقائي في هذه المادة إلى <b>{new_level}/5</b>! 📈\n\n" if is_female else
                f"<blockquote>بما أنك حققت نتيجة ممتازة ({score}%) في <b>{subj_name}</b>، فقد قمت برفع مستوى تمكنك التلقائي في هذه المادة إلى <b>{new_level}/5</b>! 📈\n\n"
                f"بدءاً من درسك القادم، سأقوم بزيادة تحديات وتفاصيل شروحاتي وأسئلتي لكِ لمساعدتكِ على التفوق. جاهزة؟ 💪</blockquote>" if is_female else
                f"بدءاً من درسك القادم، سأقوم بزيادة تحديات وتفاصيل شروحاتي وأسئلتي لك لمساعدتك على التفوق. جاهز؟ 💪</blockquote>"
            )
        elif ratio <= 0.4 and current_level > 1:
            new_level = current_level - 1
            await set_user_subject_level(user_id, subject, new_level)
            change_msg = (
                f"💡 <b>لا بأس يا {gender_title} {first_name}، كلنا نتعلم!</b>\n\n"
                f"<blockquote>أرى أنكِ واجهتِ بعض الصعوبات في اختبار <b>{subj_name}</b> ({score}%). لتسهيل المراجعة عليكِ، قمتُ بتخفيض مستوى المادة مؤقتاً إلى <b>{new_level}/5</b>.\n\n" if is_female else
                f"<blockquote>أرى أنك واجهت بعض الصعوبات في اختبار <b>{subj_name}</b> ({score}%). لتسهيل المراجعة عليك، قمت بتخفيض مستوى المادة مؤقتاً إلى <b>{new_level}/5</b>.\n\n"
                f"سأركز في شروحاتي وأسئلتي القادمة معكِ على تبسيط المفاهيم الأساسية لنبني أساساً متيناً معاً خطوة بخطوة. 💪</blockquote>" if is_female else
                f"سأركز في شروحاتي وأسئلتي القادمة معك على تبسيط المفاهيم الأساسية لنبني أساساً متيناً معاً خطوة بخطوة. 💪</blockquote>"
            )
            
        if change_msg:
            try:
                await bot.send_message(
                    chat_id=chat_id,
                    text=change_msg,
                    parse_mode="HTML"
                )
            except Exception as e:
                logging.getLogger(__name__).error(f"Error sending level adjustment message: {e}")


async def _show_results(callback: CallbackQuery, user_id: int):
    session = exam_sessions.get(user_id)
    if not session:
        return

    correct = session["correct"]
    wrong   = session["wrong"]
    total   = correct + wrong
    score   = int(score_percentage(correct, total))

    if score >= 90:   grade = "ممتاز 🌟"
    elif score >= 75: grade = "جيد جداً ✅"
    elif score >= 60: grade = "جيد 📈"
    elif score >= 50: grade = "مقبول ⚠️"
    else:             grade = "يحتاج مراجعة ❌"

    mode_names = {
        "normal":   "📘 تمارين تدريبية",
        "training": "🚀 وضعية التدريب (جديد)",
        "severe":   "🔥 وضع سيفير (Sévère)",
        "chrono":   "⏱️ التحدي بالتوقيت",
        "random":   "🎲 عشوائي",
        "errors":   "❌ مراجعة الأخطاء",
        "exam":     "📝 امتحان تجريبي",
    }
    mode_label = mode_names.get(session["mode"], session["mode"])
    elapsed    = int(time.time() - session["start_time"])
    mins, secs = elapsed // 60, elapsed % 60

    bonus_text = ""
    if session.get("subject") == "تحدي المجتمع" and score >= 50:
        bonus_text = "\n🎁 حصلت على 50 نقطة إضافية لنجاحك في التحدي!"

    text = (
        "🏁 نتيجة الاختبار\n"
        "━━━━━━━━━━━━━━━━━━━━━━\n"
        f"📝 نوع الاختبار: {mode_label}\n"
        f"❓ عدد الأسئلة: {total}\n"
        f"✅ إجابات صحيحة: {correct}\n"
        f"❌ إجابات خاطئة: {wrong}\n"
        f"📊 النتيجة: {score}%\n"
        f"🏆 التقدير: {grade}\n"
        f"⏱️ الوقت: {mins}د {secs}ث"
        f"{bonus_text}\n"
        "━━━━━━━━━━━━━━━━━━━━━━"
    )

    if user_id not in review_sessions:
        review_sessions[user_id] = {
            "questions": list(session["questions"]),
            "answers":   dict(session.get("answers", {})),
            "index":     0,
        }

    cn = session.get("course_number")
    subject = session.get("subject")

    await _finalize_exam(user_id, callback.bot, callback.message.chat.id)
    
    if score < 60 and cn is not None and subject is not None:
        from keyboards.exam_kb import failed_quiz_remediation_kb
        await callback.message.edit_text(text, reply_markup=failed_quiz_remediation_kb(subject, cn, session.get("mode", "normal")))
    else:
        # Si mode exam ou severe, on propose la révision
        if session.get("mode") in ("exam", "severe"):
            await callback.message.edit_text(text, reply_markup=end_exam_with_review_kb())
        else:
            await callback.message.edit_text(text, reply_markup=end_exam_kb())


# ── مراجعة الامتحان الرسمي سؤالاً بسؤال ─────────────────────────────────────

@router.callback_query(F.data == "review_start")
async def review_start(callback: CallbackQuery):
    user_id = callback.from_user.id
    review  = review_sessions.get(user_id)
    if not review:
        await callback.answer("لا توجد بيانات مراجعة. أعد الامتحان أولاً.", show_alert=True)
        return
    review["index"] = 0
    await _show_review_question(callback, user_id)


@router.callback_query(F.data == "rev_next")
async def review_next(callback: CallbackQuery):
    user_id = callback.from_user.id
    review  = review_sessions.get(user_id)
    if not review:
        await callback.answer("انتهت جلسة المراجعة.")
        return
    review["index"] = min(review["index"] + 1, len(review["questions"]) - 1)
    await _show_review_question(callback, user_id)


@router.callback_query(F.data == "rev_prev")
async def review_prev(callback: CallbackQuery):
    user_id = callback.from_user.id
    review  = review_sessions.get(user_id)
    if not review:
        await callback.answer("انتهت جلسة المراجعة.")
        return
    review["index"] = max(review["index"] - 1, 0)
    await _show_review_question(callback, user_id)


async def _show_review_question(callback: CallbackQuery, user_id: int):
    review = review_sessions.get(user_id)
    if not review:
        return
    idx         = review["index"]
    questions   = review["questions"]
    total       = len(questions)
    q           = questions[idx]
    chosen      = review["answers"].get(q["id"])
    correct     = q["correct"]
    explanation = q.get("explanation", "")

    is_correct  = chosen == correct
    status_icon = "✅" if is_correct else "❌"
    status_text = "إجابة صحيحة" if is_correct else "إجابة خاطئة"
    src_badge   = SOURCE_BADGE.get(q.get("source", "official"), "🏛️")
    course_info = f"📖 الدرس {q['course_number']} | " if "course_number" in q else ""

    question_quote = f"\u200f<blockquote><b>❓ السؤال:</b>\n{q['question']}</blockquote>"
    lines = [
        f"\u200f🔍 مراجعة الامتحان — السؤال {idx + 1} من {total}  {src_badge}",
        f"\u200f{course_info}{status_icon} {status_text}",
        f"\u200f━━━━━━━━━━━━━━━━━━━━━━",
        f"{question_quote}",
        f"\u200f━━━━━━━━━━━━━━━━━━━━━━",
    ]
    for letter, opt_text in q["choices"].items():
        if letter == chosen and letter == correct:
            lines.append(f"\u200f✅ <b>{letter} -</b> {opt_text}")
        elif letter == chosen:
            lines.append(f"\u200f❌ <b>{letter} -</b> {opt_text} <i>(إجابتك)</i>")
        elif letter == correct:
            lines.append(f"\u200f✔️ <b>{letter} -</b> {opt_text} <i>(الصواب)</i>")
        else:
            lines.append(f"\u200f<b>{letter} -</b> {opt_text}")
    if explanation:
        lines.append(f"\n\u200f💡 <b>توضيح:</b>\n<blockquote>\u200f{explanation}</blockquote>")

    # Utilisation du bouton large pour la question
    nav_kb_buttons = exam_review_nav_kb(idx, total, q_id=q['id']).inline_keyboard
    
    # Bouton d'explication IA toujours visible
    nav_kb_buttons.insert(0, [InlineKeyboardButton(text="🔍 شرح السؤال (IA)", callback_data=f"show_expl_{q['id']}")])

    final_kb = make_question_display_kb(q["question"], nav_kb_buttons)

    await callback.message.edit_text(
        "\n".join(lines),
        reply_markup=final_kb,
        parse_mode="HTML"
    )


@router.callback_query(F.data == "review_result")
async def review_back_to_result(callback: CallbackQuery):
    user_id = callback.from_user.id
    review  = review_sessions.get(user_id)
    if review:
        total   = len(review["questions"])
        correct = sum(
            1 for q in review["questions"]
            if review["answers"].get(q["id"]) == q["correct"]
        )
        score = int(score_percentage(correct, total))
        text  = (
            f"🏁 نتيجة الامتحان\n"
            f"━━━━━━━━━━━━━━━━━━━━━━\n"
            f"✅ {correct}/{total} — {score}%\n"
            "━━━━━━━━━━━━━━━━━━━━━━"
        )
    else:
        text = "لا توجد بيانات مراجعة."
    await callback.message.edit_text(text, reply_markup=end_exam_with_review_kb())
