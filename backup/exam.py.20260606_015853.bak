@router.callback_query(F.data.startswith("enumtoggle_"))
async def enum_toggle(callback: CallbackQuery):
    subject_raw = callback.data.replace("enumtoggle_", "")
    subject = subject_raw.replace("train_", "")
    is_training = subject_raw.startswith("train_")
    
    parts = subject_raw.rsplit("_", 1) # On split par la fin pour le numéro
    actual_subject_raw = parts[0]
    actual_subject = actual_subject_raw.replace("train_", "")
    cn = int(parts[1])
    user_id = callback.from_user.id

    sel = topic_selections.setdefault(user_id, {
        "subject": actual_subject, 
        "selected": set(), 
        "mode": "number",
        "is_training": is_training
    })
    
    # Correction : réinitialiser si on change de matière ou de mode
    if sel.get("subject") != actual_subject or sel.get("mode") != "number":
        sel["subject"] = actual_subject
        sel["selected"] = {cn}
        sel["mode"] = "number"
    else:
        if cn in sel["selected"]:
            sel["selected"].discard(cn)
        else:
            sel["selected"].add(cn)

    nums = NUMBERS_BY_SUBJECT.get(actual_subject, [])
    await callback.answer()
    await callback.message.edit_reply_markup(
        reply_markup=course_number_multi_select_kb(actual_subject_raw, sel["selected"], nums)
    )

