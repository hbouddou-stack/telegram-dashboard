@router.callback_query(F.data.startswith("ecount_"))
async def count_selected(callback: CallbackQuery):
    parts     = callback.data.split("_", 2)
    count_str = parts[1]
    context   = parts[2] if len(parts) > 2 else ""

    # Cas 1: Mode Entraînement direct (Quick Training)
    if context.startswith("train_") or context.startswith("training_"):
        mode = "training"
        actual_context = context.replace("train_", "").replace("training_", "")
        await callback.message.edit_text(
            _MODE_DESC[mode],
            reply_markup=exam_confirm_kb(mode, f"{count_str}_{actual_context}")
        )
        return

    # Cas 2: Examen Complet (Full Exam) - Correction à la fin imposée
    if context.startswith("fexam_"):
        subject = context.replace("fexam_", "")
        from utils import parse_count, subject_name
        questions = await merged_for_subject(subject)
        if not questions:
            await callback.answer("⚠️ لا توجد أسئلة!")
            return
            
        random.shuffle(questions)
        count = parse_count(count_str, len(questions))
        questions = questions[:count]
        
        user_id = callback.from_user.id
        exam_sessions[user_id] = {
            "questions":        questions,
            "index":            0,
            "current_idx":      0,
            "correct":          0,
            "wrong":            0,
            "mode":             "exam", # Correction à la fin
            "start_time":       time.time(),
            "answered":         set(),
            "subject":          subject,
            "answers":          {},
        }
        
        await callback.answer(f"📝 انطلاق امتحان {subject_name(subject)}! بالتوفيق.", show_alert=True)
        await _send_question(callback, user_id)
        return

    # Cas par défaut: Options avancées (Choix du mode)
    await callback.message.edit_text(
        "🎯 اختر نوع الاختبار:",
        reply_markup=exam_type_kb(f"{count_str}_{context}")
    )


