@router.callback_query(F.data.startswith("etogglethe_"))
async def theme_toggle(callback: CallbackQuery):
    from keyboards.exam_kb import thematic_options_kb
    rest    = callback.data.replace("etogglethe_", "")
    parts   = rest.rsplit("_", 1) 
    subject_raw = parts[0]
    idx = int(parts[1])
    
    subject_clean = subject_raw.replace("train_", "")
    themes = SIRA_THEMES if subject_clean.lower() in ("sira", "السيرة") else FIQH_THEMES
    theme_name = themes[idx]
    
    user_id = callback.from_user.id
    sel = topic_selections.setdefault(user_id, {"subject": subject_raw, "selected": set(), "mode": "theme"})
    
    if sel.get("subject") != subject_raw or sel.get("mode") != "theme":
        sel["subject"] = subject_raw
        sel["selected"] = {theme_name}
        sel["mode"] = "theme"
    else:
        if theme_name in sel["selected"]:
            sel["selected"].discard(theme_name)
        else:
            sel["selected"].add(theme_name)
            
    await callback.answer()
    await callback.message.edit_reply_markup(
        reply_markup=thematic_options_kb(subject_raw, sel["selected"])
    )


@router.callback_query(F.data.startswith("econfirm_theme_"))
async def confirm_theme(callback: CallbackQuery):
    subject_raw = callback.data.replace("econfirm_theme_", "")
    subject = subject_raw.replace("train_", "")
    is_training = subject_raw.startswith("train_")
    
    user_id = callback.from_user.id
    sel = topic_selections.get(user_id, {})
    is_training = is_training or sel.get("is_training", False)
    
    selected = sel.get("selected", set())
    
    if not selected:
        await callback.answer("يرجى اختيار محور واحد على الأقل.")
        return
        
    themes_list = sorted(list(selected))
    from question_pool import merged_for_themes
    questions = await merged_for_themes(subject, themes_list)
    
    context = "session_theme"
    
    if not questions:
        await callback.answer("لا توجد أسئلة لهذه الاختيارات حالياً.")
        return
        
    if is_training:
        settings = practice_settings.setdefault(user_id, {
            "review_type": "theme",
            "correction_style": "immediate",
            "chrono_seconds": 0,
            "question_filter": "all",
            "question_source": "official",
            "question_count": "all",
        })
        await launch_practice_direct(callback, subject, f"train_{context}", settings)
        return
        
    await callback.message.edit_text(
        f"✅ تم اختيار المحاور\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n"
        f"🎯 {subject_name(subject)}\n"
        f"📌 {' | '.join(themes_list[:10])}{' ...' if len(themes_list) > 10 else ''}\n"
        f"❓ عدد الأسئلة المتاحة: {len(questions)}\n\n"
        "اختر عدد الأسئلة:",
        reply_markup=question_count_kb(context)
    )


@router.callback_query(F.data.startswith("etogglet_"))
async def topic_toggle(callback: CallbackQuery):
    rest    = callback.data.replace("etogglet_", "")
    parts   = rest.rsplit("_", 1) 
    subject_raw = parts[0]
    topic_name = parts[1] # C'est le nom du cours (ex: غزوة أحد)
    user_id = callback.from_user.id

    sel = topic_selections.setdefault(user_id, {"subject": subject_raw, "selected": set(), "mode": "topic"})
    
    if sel.get("subject") != subject_raw or sel.get("mode") != "topic":
        sel["subject"] = subject_raw
        sel["selected"] = {topic_name}
        sel["mode"] = "topic"
    else:
        if topic_name in sel["selected"]:
            sel["selected"].discard(topic_name)
        else:
            sel["selected"].add(topic_name)

    await callback.answer()
    await callback.message.edit_reply_markup(
        reply_markup=topic_multi_select_kb(subject_raw, sel["selected"])
    )


@router.callback_query(F.data.startswith("econfirm_multi_"))
async def confirm_multi(callback: CallbackQuery):
    subject_raw = callback.data.replace("econfirm_multi_", "")
    subject = subject_raw.replace("train_", "")
    is_training = subject_raw.startswith("train_")
    
    user_id  = callback.from_user.id
    sel      = topic_selections.get(user_id, {})
    # On vérifie aussi dans la session si le prefixe n'était pas dans le callback
    is_training = is_training or sel.get("is_training", False)
    
    selected = sel.get("selected", set())
    mode     = sel.get("mode", "topic")
    
    if not selected:
        await callback.answer("يرجى اختيار موضوع واحد على الأقل.")
        return

    # Résolution des noms pour l'affichage
    cns = sorted(list(selected))
    questions = await merged_for_courses(cns, subject=subject)
    
    if mode == "topic":
        # On affiche les noms des sujets
        topics_labels = [get_course(cn, subject=subject)['name'] for cn in cns]
        context = "session_topic"
    else:
        # On affiche les numéros
        topics_labels = [str(cn) for cn in cns]
        context = "session_number"
    
    if not questions:
        await callback.answer("لا توجد أسئلة لهذه الاختيارات حالياً.")
        return

    if is_training:
        settings = practice_settings.setdefault(user_id, {
            "review_type": "course",
            "correction_style": "immediate",
            "chrono_seconds": 0,
            "question_filter": "all",
            "question_source": "official",
            "question_count": "all",
        })
        await launch_practice_direct(callback, subject, f"train_{context}", settings)
        return

    # Si on est en mode examen, on demande le nombre de questions (car pas de réglages généraux pour l'examen)
    await callback.message.edit_text(
        f"✅ تم اختيار المواضيع\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n"
        f"📚 {subject_name(subject)}\n"
        f"📌 {' | '.join(topics_labels[:10])}{' ...' if len(topics_labels) > 10 else ''}\n"
        f"❓ عدد الأسئلة المتاحة: {len(questions)}\n\n"
        "اختر عدد الأسئلة:",
        reply_markup=question_count_kb(context)
    )


