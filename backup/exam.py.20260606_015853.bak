@router.callback_query(F.data == "menu_nouveautes")
async def menu_nouveautes(callback: CallbackQuery):
    summary = await get_recent_questions_summary()
    
    if not summary:
        text = (
            "🆕 <b>جديد الأسئلة المضافة مؤخراً</b>\n"
            "━━━━━━━━━━━━━━━━━━━━━━\n\n"
            "✨ لا توجد أسئلة جديدة مضافة في الـ 7 أيام الأخيرة.\n\n"
            "💡 <i>يتم تحديث الأسئلة تلقائياً عند إضافة مساهمات جديدة من الطلاب أو توليد أسئلة بالذكاء الاصطناعي!</i>"
        )
        keyboard = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="↩️ العودة", callback_data="menu_learning")]
        ])
        await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")
        return
        
    text = (
        "🆕 <b>جديد الأسئلة المضافة مؤخراً (آخر 7 أيام)</b>\n"
        "━━━━━━━━━━━━━━━━━━━━━━\n\n"
        "إليك قائمة بالدروس التي تمت إضافة أسئلة جديدة لها مؤخراً :\n\n"
    )
    
    # Group by subject
    by_subject = {}
    for item in summary:
        by_subject.setdefault(item["subject"], []).append(item)
        
    for sub, items in by_subject.items():
        sub_name = subject_name(sub)
        text += f"📚 <b>{sub_name}</b> :\n"
        
        # Group by course
        by_course = {}
        for it in items:
            by_course.setdefault(it["course_number"], []).append(it)
            
        for cn, it_list in by_course.items():
            course_title = it_list[0]["course_name"] or ""
            course_disp = f"الدرس {cn} : {course_title}" if course_title else f"الدرس {cn}"
            
            detail_strs = []
            for it in it_list:
                src = it["source"]
                cnt = it["count"]
                if src == "ai":
                    detail_strs.append(f"🤖 +{cnt} ذكاء")
                elif src in ("contribution", "remarkable"):
                    detail_strs.append(f"👨‍🎓 +{cnt} مساهمة")
                else:
                    detail_strs.append(f"🏛️ +{cnt} رسمي")
                    
            text += f" ├ <b>{course_disp}</b> ({', '.join(detail_strs)})\n"
        text += "━━━━━━━━━━━━\n\n"
        
    text += "🎯 <i>اختر المادة والدرس من قائمة المراجعة لبدء اختبار معلوماتك مباشرة !</i>"
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="↩️ العودة", callback_data="menu_learning")]
    ])
    await callback.message.edit_text(text, reply_markup=keyboard, parse_mode="HTML")



# ── Nouveaux Helpers & Handlers pour la Refonte UX du Mode Exercice ───────────

async def show_subject_dashboard(callback: CallbackQuery, subject: str):
    user_id = callback.from_user.id
    
    settings = practice_settings.setdefault(user_id, {
        "review_type": "course",      # course (par cours) ou theme (par thème)
        "correction_style": "immediate", # immediate (fouri) ou end (à la fin)
        "chrono_seconds": 0,           # 0 (sans), 30s, 60s
        "question_filter": "all",       # all (toutes) ou errors (erreurs)
        "question_source": "official",  # official (officiel) ou community (communautaire)
        "question_count": "all",        # default to all
    })
    
    rev_type_ar = "🎯 حسب المحاور (Par Thème)" if settings.get("review_type") == "theme" else "📖 حسب الدروس (Par Cours)"
    corr_style_ar = "⚡ تصحيح فوري (Immédiat)" if settings.get("correction_style") == "immediate" else "📝 في النهاية (À la fin)"
    chrono_sec = settings.get("chrono_seconds", 0)
    chrono_ar = "♾️ بدون وقت (Sans chrono)" if chrono_sec == 0 else f"⏰ {chrono_sec} ثانية"
    q_filter_ar = "🔄 كل الأسئلة (Toutes)" if settings.get("question_filter") == "all" else "❌ الأخطاء فقط (Erreurs)"
    q_source = settings.get("question_source", "official")
    if q_source == "community":
        q_source_ar = "👥 مساهمات الطلاب (Communauté)"
    elif q_source == "ai":
        q_source_ar = "⚡ مقترح من الإدارة"
    else:
        q_source_ar = "📚 أسئلة الأكاديمية (Officiel)"
        
    q_count = settings.get("question_count", "all")
    if q_count == "all":
        q_count_ar = "🔄 كل الأسئلة (Toutes)"
    elif q_count == 5:
        q_count_ar = "📊 5 أسئلة"
    elif q_count == 10:
        q_count_ar = "📊 10 أسئلة"
    elif q_count == 20:
        q_count_ar = "📊 20 سؤالاً"
    else:
        q_count_ar = f"📊 {q_count} أسئلة"
    
    text = (
        f"📚 <b>مادة: {subject_name(subject)}</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n"
        f"⚙️ <b>الإعدادات الحالية للتدريب :</b>\n\n"
        f"• <b>نوع الترتيب :</b> {rev_type_ar}\n"
        f"• <b>عدد الأسئلة :</b> {q_count_ar}\n"
        f"• <b>أسلوب التصحيح :</b> {corr_style_ar}\n"
        f"• <b>مؤقت الإجابة :</b> {chrono_ar}\n"
        f"• <b>نطاق الأسئلة :</b> {q_filter_ar}\n"
        f"• <b>مصدر الأسئلة :</b> {q_source_ar}\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n\n"
        f"🚀 جاهز للبدء؟ اضغط على زر البدء بالأسفل :"
    )
    
    await callback.message.edit_text(
        text=text,
        reply_markup=subject_options_kb(subject),
        parse_mode="HTML"
    )


async def launch_practice_direct(callback: CallbackQuery, subject: str, scope: str, settings: dict):
    user_id = callback.from_user.id
    
    mode = "training"
    if settings.get("question_filter") == "errors":
        mode = "errors"
    elif settings.get("correction_style") == "end":
        mode = "exam"

    questions = await _resolve_questions(callback, mode, scope)
    if not questions:
        await callback.answer("⚠️ لا توجد أسئلة متاحة حالياً!")
        return

    # Slice questions by settings['question_count']
    from utils import parse_count
    q_count_setting = str(settings.get("question_count", "all"))
    count = parse_count(q_count_setting, len(questions))
    questions = questions[:count]

    if not questions:
        await callback.answer("⚠️ لا توجد أسئلة بعد التصفية!")
        return

    if settings.get("question_filter") == "errors":
        random.shuffle(questions)

    chrono_sec = int(settings.get("chrono_seconds", 0))

    exam_sessions[user_id] = {
        "questions":   questions,
        "index":       0,
        "current_idx": 0,
        "correct":     0,
        "wrong":       0,
        "mode":        mode,
        "start_time":  time.time(),
        "answered":    set(),
        "subject":     subject,
        "answers":     {},
        "chrono_sec":  chrono_sec,
    }
    
    if scope.startswith("cn_"):
        raw_cn = scope.replace("cn_", "").split("_")[-1]
        exam_sessions[user_id]["course_number"] = int(raw_cn)
    elif scope.startswith("hijrayear_"):
        raw_year = scope.replace("hijrayear_", "").split("_")[-1]
        exam_sessions[user_id]["hijra_year"] = int(raw_year)
        
    await callback.answer("💪 انطلاق التدريب!")
    await _send_question(callback, user_id)


