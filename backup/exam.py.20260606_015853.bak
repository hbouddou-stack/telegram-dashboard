@router.callback_query(F.data.startswith("train_ecourse_"))
@router.callback_query(F.data.startswith("ecourse_"))
async def course_selected(callback: CallbackQuery):
    is_training = "train_" in callback.data
    # On nettoie pour avoir le sujet et le numéro : ecourse_{subject}_{cn}
    raw = callback.data.replace("train_", "").replace("ecourse_", "")
    parts = raw.split("_")
    if len(parts) < 2:
        # Fallback pour ancienne version si besoin
        course_number = int(parts[0])
        c = get_course(course_number)
        subject = c['subject'] if c else "fiqh"
    else:
        subject = parts[0]
        course_number = int(parts[1])
    
    questions = await merged_for_course(course_number, subject=subject)
    if not questions:
        await callback.answer("لا توجد أسئلة لهذا الدرس حالياً.")
        return
        
    c = get_course(course_number, subject=subject)
    if is_training:
        # On passe directement au choix du nombre de questions
        context = f"train_cn_{subject}_{course_number}"
        await callback.message.edit_text(
            f"✅ تم اختيار الدرس {course_number}\n"
            f"━━━━━━━━━━━━━━━━━━━━━━\n"
            f"📖 {c['name']}\n"
            f"❓ عدد الأسئلة المتاحة: {len(questions)}\n\n"
            "اختر عدد الأسئلة:",
            reply_markup=question_count_kb(context)
        )
        return

    # On inclut le sujet dans le contexte pour lever toute ambiguïté plus tard
    context = f"5_cn_{subject}_{course_number}"
    await callback.message.edit_text(
        f"✅ تم اختيار الدرس {course_number}\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n"
        f"📖 {c['name']}\n\n"
        "🎯 اختر نوع الاختبار:",
        reply_markup=exam_type_kb(context)
    )


