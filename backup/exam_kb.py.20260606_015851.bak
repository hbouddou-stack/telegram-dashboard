def admin_feedback_menu_kb(counts_dict: dict):
    prob_c = counts_dict.get("problem", {}).get("unread_cnt", 0)
    prob_crit = counts_dict.get("problem", {}).get("crit_cnt", 0)
    imp_c = counts_dict.get("improvement", {}).get("unread_cnt", 0)
    rev_c = counts_dict.get("review", {}).get("unread_cnt", 0)
    
    p_icon = "🔴" if prob_crit > 0 else ""
    
    prob_text = f"{p_icon}🚨 مشاكل ({prob_c})" if prob_c > 0 else "🚨 مشاكل"
    imp_text = f"💡 تحسينات ({imp_c})" if imp_c > 0 else "💡 تحسينات"
    rev_text = f"⭐ تقييمات ({rev_c})" if rev_c > 0 else "⭐ تقييمات"
    
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=prob_text, callback_data="admin_fb_cat_problem")],
        [InlineKeyboardButton(text=imp_text, callback_data="admin_fb_cat_improvement")],
        [InlineKeyboardButton(text=rev_text, callback_data="admin_fb_cat_review")],
        [InlineKeyboardButton(text="↩️ لوحة الإدارة", callback_data="admin_panel")]
    ])


def admin_feedback_status_menu_kb(category: str, counts: dict = None):
    """Menu intermédiaire en deux colonnes pour choisir le statut."""
    if not counts:
        counts = {"pending": 0, "in_progress": 0, "archived": 0}
        
    return InlineKeyboardMarkup(inline_keyboard=[
        # En-têtes
        [
            InlineKeyboardButton(text="📩 العدد", callback_data="noop"),
            InlineKeyboardButton(text="📁 الحالة", callback_data="noop"),
        ],
        # Lignes du tableau
        [
            InlineKeyboardButton(text=f"({counts['pending']})", callback_data=f"admin_fb_list_{category}_pending"),
            InlineKeyboardButton(text="🔴 غير معالجة", callback_data=f"admin_fb_list_{category}_pending"),
        ],
        [
            InlineKeyboardButton(text=f"({counts['in_progress']})", callback_data=f"admin_fb_list_{category}_in_progress"),
            InlineKeyboardButton(text="🟡 قيد المعالجة", callback_data=f"admin_fb_list_{category}_in_progress"),
        ],
        [
            InlineKeyboardButton(text=f"({counts['archived']})", callback_data=f"admin_fb_list_{category}_archived"),
            InlineKeyboardButton(text="✅ تمت المعالجة", callback_data=f"admin_fb_list_{category}_archived"),
        ],
        [InlineKeyboardButton(text="↩️ رجوع للتصنيفات", callback_data="admin_inbox")]
    ])


def admin_feedback_action_kb(feedback_id: int, idx: int = 0, total: int = 1, category: str = "", msg_status: str = "pending", list_status: str = "pending"):
    rows = []
    
    # Specific buttons for Technical Problems
    if category == "problem":
        status_row = []
        if msg_status != "in_progress":
            status_row.append(InlineKeyboardButton(text="🟡 قيد المعالجة", callback_data=f"admin_fb_st_{feedback_id}_in_progress_{list_status}"))
        if msg_status != "transferred":
            status_row.append(InlineKeyboardButton(text="🟣 تحويل", callback_data=f"admin_fb_st_{feedback_id}_transferred_{list_status}"))
        if msg_status != "resolved":
            status_row.append(InlineKeyboardButton(text="🟢 تم الحل", callback_data=f"admin_fb_st_{feedback_id}_resolved_{list_status}"))
        if status_row:
            rows.append(status_row)
        
        # Add reply button for problems too
        rows.append([InlineKeyboardButton(text="💬 الرد على الطالب", callback_data=f"admin_fb_reply_{feedback_id}_{list_status}")])
    else:
        if msg_status == "pending":
            rows.append([
                InlineKeyboardButton(text="💬 الرد على الطالب", callback_data=f"admin_fb_reply_{feedback_id}_{list_status}"),
                InlineKeyboardButton(text="✅ علامة كمقروء", callback_data=f"admin_fb_read_{feedback_id}_{list_status}")
            ])
    
    nav = []
    if idx > 0:
        nav.append(InlineKeyboardButton(text="◀️ السابق", callback_data=f"admin_fb_nav_{category}_{list_status}_{idx - 1}"))
    if idx < total - 1:
        nav.append(InlineKeyboardButton(text="التالي ▶️", callback_data=f"admin_fb_nav_{category}_{list_status}_{idx + 1}"))
    
    if nav:
        rows.append(nav)
    
    rows.append([InlineKeyboardButton(text="↩️ رجوع للقائمة", callback_data=f"admin_fb_cat_{category}")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


# ── Refonte UX — Claviers de Fiche de Bord et Personnalisation ─────────────────

def subject_options_kb(subject: str):
    """
    Clavier minimaliste pour la Fiche de Bord d'une matière en Mode Exercice.
    """
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="▶️ ابدأ التدريب", callback_data=f"start_practice_{subject}")],
        [InlineKeyboardButton(text="⚙️ تخصيص الإعدادات", callback_data=f"custom_settings_{subject}")],
        [InlineKeyboardButton(text="🏠 القائمة الرئيسية", callback_data="back_main")]
    ])


def customize_settings_kb(subject: str, settings: dict):
    """
    Clavier de personnalisation sous forme de toggles à bascule pour modifier les paramètres de session.
    """
    rows = []
    
    # 1. Type de Révision : Par Cours vs Par Thématique
    rev_type = settings.get("review_type", "course")
    if rev_type == "theme":
        rev_label = "🎯 الترتيب: حسب المحاور (Thématique)"
    else:
        rev_label = "📖 الترتيب: حسب الدروس (Par Cours)"
    rows.append([InlineKeyboardButton(text=rev_label, callback_data=f"toggle_setting_{subject}_review")])
    
    # 2. Style de Correction : Immédiat vs À la fin
    corr_style = settings.get("correction_style", "immediate")
    if corr_style == "end":
        corr_label = "📝 التصحيح: في النهاية (À la fin)"
    else:
        corr_label = "⚡ التصحيح: فوري (Immédiat)"
    rows.append([InlineKeyboardButton(text=corr_label, callback_data=f"toggle_setting_{subject}_correct")])
    
    # 3. Type de Chrono : Sans chrono vs 30s vs 60s
    chrono_sec = int(settings.get("chrono_seconds", 0))
    if chrono_sec == 30:
        chrono_label = "⏰ الوقت: 30 ثانية"
    elif chrono_sec == 60:
        chrono_label = "⏰ الوقت: 60 ثانية"
    else:
        chrono_label = "♾️ الوقت: بدون وقت (Sans chrono)"
    rows.append([InlineKeyboardButton(text=chrono_label, callback_data=f"toggle_setting_{subject}_chrono")])
    
    # 4. Nombre de questions : 5 vs 10 vs 20 vs Toutes
    q_count = settings.get("question_count", "all")
    if q_count == 5:
        count_label = "📊 عدد الأسئلة: 5 أسئلة"
    elif q_count == 10:
        count_label = "📊 عدد الأسئلة: 10 أسئلة"
    elif q_count == 20:
        count_label = "📊 عدد الأسئلة: 20 سؤالاً"
    else:
        count_label = "📊 عدد الأسئلة: كل الأسئلة (Toutes)"
    rows.append([InlineKeyboardButton(text=count_label, callback_data=f"toggle_setting_{subject}_count")])
    
    # 5. Sélection de Questions : Toutes vs Uniquement mes erreurs
    q_filter = settings.get("question_filter", "all")
    if q_filter == "errors":
        filter_label = "❌ الأسئلة: الأخطاء فقط (Mes Erreurs)"
    else:
        filter_label = "🔄 الأسئلة: كل الأسئلة (Toutes)"
    rows.append([InlineKeyboardButton(text=filter_label, callback_data=f"toggle_setting_{subject}_filter")])
    
    # 5. Source des Questions : Officielle vs Communautaire vs AI
    q_source = settings.get("question_source", "official")
    if q_source == "community":
        source_label = "👥 المصدر: مساهمات الطلاب (Communauté)"
    elif q_source == "ai":
        source_label = "⚡ المصدر: مقترح من الإدارة"
    else:
        source_label = "📚 المصدر: أسئلة الأكاديمية (Officiel)"
    rows.append([InlineKeyboardButton(text=source_label, callback_data=f"toggle_setting_{subject}_source")])
    
    # 6. Bouton de sauvegarde et retour
    rows.append([InlineKeyboardButton(text="💾 حفظ ورجوع", callback_data=f"save_settings_{subject}")])
    
    return InlineKeyboardMarkup(inline_keyboard=rows)


def sira_hijra_years_kb(is_training: bool = False):
    prefix = "train_" if is_training else ""
    years = [2, 3, 4, 5, 6, 7, 8, 9, 10]
    rows = []
    for i in range(0, len(years), 3):
        row = []
        for y in years[i:i+3]:
            row.append(InlineKeyboardButton(text=f"السنة {y} هـ", callback_data=f"{prefix}ehijra_year_{y}"))
        rows.append(row)
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=f"exam_subj_sira")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


