# ── وصف نوع الاختبار قبل البدء (تأكيد) ──────────────────────────────────────

def exam_confirm_kb(mode: str, rest: str):
    """Shown before starting an exam — gives a description and a confirm button."""
    rows = []
    
    # Intégration du Pont Pédagogique : Révision rapide avant l'examen
    parts = rest.split("_")
    if len(parts) >= 4 and parts[1] == "cn":
        subject = parts[2]
        course_number = parts[3]
        rows.append([
            InlineKeyboardButton(
                text="⚡ مراجعة سريعة قبل الاختبار (Fiche IA)", 
                callback_data=f"ai_flashcard_exam_{subject}_{course_number}_{mode}_{rest}"
            )
        ])
        
    if mode == "normal":
        rows.append([InlineKeyboardButton(text="✅ Mode Classique (Correction directe)", callback_data=f"estart_normal_{rest}")])
        rows.append([InlineKeyboardButton(text="🔥 Mode Sévère (Correction à la fin)", callback_data=f"estart_severe_{rest}")])
    else:
        rows.append([InlineKeyboardButton(text="✅ ابدأ الآن", callback_data=f"estart_{mode}_{rest}")])
    
    rows.append([InlineKeyboardButton(text="↩️ تغيير النوع", callback_data=f"ecount_{rest}")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


# ── الدرس التوجيهي ────────────────────────────────────────────────────────────

def tutorial_nav_kb(page: int, total: int = 3):
    nav = []
    if page > 1:
        nav.append(InlineKeyboardButton(text="◀️ السابق",  callback_data=f"tutorial_p{page - 1}"))
    if page < total:
        nav.append(InlineKeyboardButton(text="التالي ▶️",  callback_data=f"tutorial_p{page + 1}"))
    rows = []
    if nav:
        rows.append(nav)
    rows.append([InlineKeyboardButton(text="🏠 القائمة الرئيسية", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


# ── المفضلة — اختيار المادة أولاً ────────────────────────────────────────────

def favorites_subjects_kb(subjects_with_counts: dict):
    keys = [s for s in SUBJECTS.keys() if s in subjects_with_counts]
    rows = []
    for i in range(0, len(keys), 2):
        row = []
        for key in keys[i:i + 2]:
            count = subjects_with_counts[key]
            num   = SUBJECT_NUM.get(key, "•")
            name  = SUBJECT_SHORT.get(key, key)
            row.append(InlineKeyboardButton(
                text=f"{num}. {name} ({count})",
                callback_data=f"fav_subj_{key}"
            ))
        rows.append(row)
    rows.append([InlineKeyboardButton(text="🏠 القائمة الرئيسية", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


def favorites_list_kb(questions: list, back_cb: str = "menu_favorites"):
    rows = []
    for i, q in enumerate(questions, 1):
        qid  = q["id"]
        cn   = q.get("course_number", "?")
        subj = SUBJECT_SHORT.get(q.get("subject", ""), "")
        info = f"درس {cn}" + (f" — {subj}" if subj else "")
        rows.append([
            InlineKeyboardButton(text="🗑️ حذف",            callback_data=f"fav_del_{qid}"),
            InlineKeyboardButton(text=f"📖 س{i} | {info}", callback_data=f"fav_view_{qid}"),
        ])
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=back_cb)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


