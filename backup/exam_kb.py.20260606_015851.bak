def exam_review_nav_kb(current: int, total: int, q_id: int = None):
    nav = []
    if current > 0:
        nav.append(InlineKeyboardButton(text="◀️ السابق", callback_data="rev_prev"))
    if current < total - 1:
        nav.append(InlineKeyboardButton(text="التالي ▶️", callback_data="rev_next"))
