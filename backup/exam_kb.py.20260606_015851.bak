def topic_multi_select_kb(subject_raw: str, selected: set):
    """Sélecteur multiple par NOMS de thématiques, utilise les numéros en callback pour la stabilité."""
    subject_clean = subject_raw.replace("train_", "")
    is_training = subject_raw.startswith("train_")
    
    courses = COURSES_BY_SUBJECT.get(subject_clean, [])
    rows = []
    for c in courses:
        cn = c["course_number"]
        name = c["name"]
        mark = "✅" if cn in selected else "⬜"
        label = f"{mark} {name}"
        # Utilisation du numéro (cn) pour éviter de dépasser 64 octets dans le callback
        rows.append([InlineKeyboardButton(text=label, callback_data=f"etogglet_{subject_raw}_{cn}")])
    
    if selected:
        rows.append([InlineKeyboardButton(
            text=f"✔️ تأكيد الاختيار ({len(selected)} موضوع)",
            callback_data=f"econfirm_multi_{subject_raw}"
        )])
        
    back_cb = f"train_subj_{subject_clean}" if is_training else f"exam_subj_{subject_clean}"
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=back_cb)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


def thematic_options_kb(subject_raw: str, selected: set):
    """Sélecteur multiple par AXES thématiques (Sira/Fiqh) pour éviter les limitations de longueur callback."""
    subject_clean = subject_raw.replace("train_", "")
    is_training = subject_raw.startswith("train_")
    
    themes = []
    if subject_clean.lower() in ("sira", "السيرة"):
        themes = [
            "الشمائل والأخلاق النبوية",
            "بيت النبوة والحياة الشخصية",
            "العبادات والتشريعات",
            "الغزوات والسرايا"
        ]
    elif subject_clean.lower() in ("fiqh", "الفقه"):
        themes = [
            "فرائض الصلاة",
            "شروط الصلاة",
            "سنن الصلاة",
            "مندوبات الصلاة",
            "مكروهات ومبطلات الصلاة",
            "صلاة الجمعة",
            "سجود السهو",
            "فرض عين / فرض كفاية",
            "شروط الإمام"
        ]
    
    rows = []
    for idx, theme_name in enumerate(themes):
        mark = "✅" if theme_name in selected else "⬜"
        label = f"{mark} {theme_name}"
        rows.append([InlineKeyboardButton(text=label, callback_data=f"etogglethe_{subject_raw}_{idx}")])
        
    if selected:
        rows.append([InlineKeyboardButton(
            text=f"✔️ تأكيد الاختيار ({len(selected)} محور)",
            callback_data=f"econfirm_theme_{subject_raw}"
        )])
        
    back_cb = f"train_subj_{subject_clean}" if is_training else f"exam_subj_{subject_clean}"
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=back_cb)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


# ── شبكة أرقام الدروس ────────────────────────────────────────────────────────

def course_number_multi_select_kb(subject: str, selected: set, course_numbers: list):
    """Grille de numéros multi-sélection [✅ 1] [2] [3]."""
    admin_hidden = session_state.get_hidden()
    
    rows = []
    row = []
    for cn in course_numbers:
        if cn in admin_hidden:
            continue
        
        is_sel = cn in selected
        mark = "✅ " if is_sel else ""
        label = f"{mark}{cn}"
        row.append(InlineKeyboardButton(text=label, callback_data=f"enumtoggle_{subject}_{cn}"))
        
        if len(row) == 5: # 5 colonnes pour la lisibilité
            rows.append(row)
            row = []
    if row:
        rows.append(row)
        
    if selected:
        rows.append([InlineKeyboardButton(
            text=f"✔️ تأكيد الأرقام المختارة ({len(selected)})",
            callback_data=f"econfirm_multi_{subject}"
        )])
        
    subject_clean = subject.replace("train_", "")
    is_training = subject.startswith("train_")
    back_cb = f"train_subj_{subject_clean}" if is_training else f"exam_subj_{subject_clean}"
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=back_cb)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


