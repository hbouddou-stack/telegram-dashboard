# ── اختيار المادة ─────────────────────────────────────────────────────────────

async def subjects_kb(user_id: int, prefix: str = "exam_subj", hidden_subjects: list = None):
    if hidden_subjects is None:
        hidden_subjects = []
    
    from database.progress import get_all_subjects_status_emojis
    status_emojis = await get_all_subjects_status_emojis(user_id)
    
    keys = [k for k in SUBJECTS.keys() if k not in hidden_subjects and k not in INACTIVE_SUBJECTS]
    rows = []
    
    # Création de paires pour la grille 2x2
    for i in range(0, len(keys), 2):
        row = []
        # Premier bouton de la paire
        k1 = keys[i]
        emoji1 = SUBJECT_NUM.get(k1, "📚")
        status_emoji1 = status_emojis.get(k1, "💤")
        name1 = SUBJECTS[k1]
        row.append(InlineKeyboardButton(text=f"{status_emoji1} {emoji1} {name1}", callback_data=f"{prefix}_{k1}"))
        
        # Deuxième bouton de la paire (si présent)
        if i + 1 < len(keys):
            k2 = keys[i+1]
            emoji2 = SUBJECT_NUM.get(k2, "📚")
            status_emoji2 = status_emojis.get(k2, "💤")
            name2 = SUBJECTS[k2]
            row.append(InlineKeyboardButton(text=f"{status_emoji2} {emoji2} {name2}", callback_data=f"{prefix}_{k2}"))
            
        rows.append(row)
    
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=rows)



