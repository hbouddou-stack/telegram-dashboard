def _should_use_single_column(choices: dict, max_len: int = 15) -> bool:
    """
    Détermine si on doit utiliser un affichage sur une seule colonne (liste)
    plutôt qu'une grille 2x2. Si au moins une option dépasse max_len, on renvoie True.
    """
    return any(len(str(text)) > max_len for text in choices.values())


def _should_use_letter_buttons(choices: dict, max_len: int = 18) -> bool:
    """
    Détermine si on doit utiliser un affichage avec des boutons de lettres
    uniquement (et afficher les textes dans le message) pour éviter la troncature sur mobile.
    """
    return any(len(str(text)) > max_len for text in choices.values())


def answer_kb(q_id: int, choices: dict):
    rows = []
    items = list(choices.items())
    ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
    
    if _should_use_single_column(choices, max_len=15):
        for letter, text in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            rows.append([InlineKeyboardButton(
                text=f"\u200f{ar_letter} - {text}",
                callback_data=f"answer_{q_id}_{letter}"
            )])
    else:
        for i in range(0, len(items), 2):
            row = []
            for letter, text in items[i:i + 2]:
                ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
                row.append(InlineKeyboardButton(
                    text=f"\u200f{ar_letter} - {text}",
                    callback_data=f"answer_{q_id}_{letter}"
                ))
            rows.append(row)
            
    # Ligne séparatrice sous forme de bouton à la fin des choix
    rows.append([InlineKeyboardButton(text="━━━━━━━━━━━━━━━━━━━━━━", callback_data="noop")])
    
    rows.append([
        InlineKeyboardButton(text="⚠️ إبلاغ عن خطأ في السؤال",    callback_data=f"report_q_id:{q_id}"),
        InlineKeyboardButton(text="⭐ أسئلتي المفضلة",    callback_data=f"fav_add_{q_id}"),
    ])
    # Bouton pour finir l'examen pendant la réflexion
    rows.append([InlineKeyboardButton(text="🚪 أنهي الاختبار", callback_data="end_exam")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


# ── Versions "question buttons only" pour utiliser avec make_question_display_kb ──

def _answer_buttons_only(q_id: int, choices: dict) -> list:
    """Retourne juste les boutons de réponse (grille ou liste intelligente) sans InlineKeyboardMarkup."""
    rows = []
    items = list(choices.items())
    ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
    
    if _should_use_letter_buttons(choices):
        letter_row = []
        for letter, _ in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            letter_row.append(InlineKeyboardButton(
                text=f"\u200f[{ar_letter}]",
                callback_data=f"answer_{q_id}_{letter}"
            ))
        rows.append(letter_row)
    elif _should_use_single_column(choices, max_len=15):
        for letter, text in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            rows.append([InlineKeyboardButton(
                text=f"\u200f{ar_letter} - {text}",
                callback_data=f"answer_{q_id}_{letter}"
            )])
    else:
        for i in range(0, len(items), 2):
            row = []
            for letter, text in items[i:i + 2]:
                ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
                row.append(InlineKeyboardButton(
                    text=f"\u200f{ar_letter} - {text}",
                    callback_data=f"answer_{q_id}_{letter}"
                ))
            rows.append(row)
            
    # Ligne séparatrice sous forme de bouton à la fin des choix
    rows.append([InlineKeyboardButton(text="━━━━━━━━━━━━━━━━━━━━━━", callback_data="noop")])
    
    rows.append([
        InlineKeyboardButton(text="⚠️ إبلاغ عن خطأ في السؤال",    callback_data=f"report_q_id:{q_id}"),
        InlineKeyboardButton(text="⭐ أسئلتي المفضلة",    callback_data=f"fav_add_{q_id}"),
    ])
    # Bouton pour finir l'examen pendant la réflexion
    rows.append([InlineKeyboardButton(text="🚪 أنهي الاختبار", callback_data="end_exam")])
    return rows


def _exam_answer_buttons_only(q_id: int, choices: dict, current_idx: int, total: int,
                              answered_count: int, is_answered: bool = False, 
                              chosen: str = None) -> list:
    """Retourne juste les boutons de réponse pour le mode exam (grille ou liste intelligente)."""
    rows = []
    items = list(choices.items())
    ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
    
    if _should_use_letter_buttons(choices):
        letter_row = []
        for letter, _ in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            if is_answered and chosen and letter.upper() == str(chosen).upper():
                btn_text = f"\u200f✓ {ar_letter}"
            else:
                btn_text = f"\u200f{ar_letter}"
            letter_row.append(InlineKeyboardButton(text=btn_text, callback_data=f"answer_{q_id}_{letter}"))
        rows.append(letter_row)
    elif _should_use_single_column(choices, max_len=15):
        for letter, text in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            if is_answered and chosen and letter.upper() == str(chosen).upper():
                btn_text = f"\u200f✓ {ar_letter} - {text}"
            else:
                btn_text = f"\u200f□ {ar_letter} - {text}"
            rows.append([InlineKeyboardButton(text=btn_text, callback_data=f"answer_{q_id}_{letter}")])
    else:
        for i in range(0, len(items), 2):
            row = []
            for letter, text in items[i:i + 2]:
                ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
                if is_answered and chosen and letter.upper() == str(chosen).upper():
                    btn_text = f"\u200f✓ {ar_letter} - {text}"
                else:
                    btn_text = f"\u200f□ {ar_letter} - {text}"
                row.append(InlineKeyboardButton(text=btn_text, callback_data=f"answer_{q_id}_{letter}"))
            rows.append(row)
    
    # Ligne séparatrice sous forme de bouton à la fin des choix
    rows.append([InlineKeyboardButton(text="━━━━━━━━━━━━━━━━━━━━━━", callback_data="noop")])
    
    # Navigation dans l'examen (précédent/suivant)
    nav_row = []
    if current_idx > 0:
        nav_row.append(InlineKeyboardButton(text="◀️ السابق", callback_data="exam_nav_prev"))
    if current_idx < total - 1:
        nav_row.append(InlineKeyboardButton(text="التالي ▶️", callback_data="exam_nav_next"))
    else:
        nav_row.append(InlineKeyboardButton(text="✅ إنهاء الامتحان", callback_data="exam_submit"))
    
    if nav_row:
        rows.append(nav_row)
    
    # Bouton signaler (optionnel pour le mode exam)
    rows.append([InlineKeyboardButton(text="⚠️ الإبلاغ عن خطأ في هذا السؤال", callback_data=f"report_q_id:{q_id}")])
    # Bouton pour finir l'examen pendant la réflexion
    rows.append([InlineKeyboardButton(text="🚪 أنهي الاختبار", callback_data="end_exam")])
    return rows


def exam_question_nav_kb(q_id: int, choices: dict, current_idx: int, total: int,
                          answered_count: int, is_answered: bool = False, chosen: str = None):
    rows = []
    items = list(choices.items())
    ARABIC_CHOICE = {"a": "أ", "b": "ب", "c": "ج", "d": "د"}
    
    if _should_use_letter_buttons(choices):
        letter_row = []
        for letter, _ in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            if is_answered and chosen and letter.upper() == str(chosen).upper():
                btn_text = f"\u200f✓ {ar_letter}"
            else:
                btn_text = f"\u200f{ar_letter}"
            letter_row.append(InlineKeyboardButton(text=btn_text, callback_data=f"answer_{q_id}_{letter}"))
        rows.append(letter_row)
    elif _should_use_single_column(choices, max_len=15):
        for letter, text in items:
            ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
            if is_answered and chosen and letter.upper() == str(chosen).upper():
                btn_text = f"\u200f✓ {ar_letter} - {text}"
            else:
                btn_text = f"\u200f□ {ar_letter} - {text}"
            rows.append([InlineKeyboardButton(text=btn_text, callback_data=f"answer_{q_id}_{letter}")])
    else:
        for i in range(0, len(items), 2):
            row = []
            for letter, text in items[i:i + 2]:
                ar_letter = ARABIC_CHOICE.get(letter.lower(), letter.upper())
                if is_answered and chosen and letter.upper() == str(chosen).upper():
                    btn_text = f"\u200f✓ {ar_letter} - {text}"
                else:
                    btn_text = f"\u200f□ {ar_letter} - {text}"
                row.append(InlineKeyboardButton(text=btn_text, callback_data=f"answer_{q_id}_{letter}"))
            rows.append(row)

    # Ligne séparatrice sous forme de bouton à la fin des choix
    rows.append([InlineKeyboardButton(text="━━━━━━━━━━━━━━━━━━━━━━", callback_data="noop")])

    rows.append([
        InlineKeyboardButton(text="📮 إبلاغ",             callback_data=f"report_q_id:{q_id}"),
        InlineKeyboardButton(text="⭐ أسئلتي المفضلة",    callback_data=f"fav_add_{q_id}"),
    ])

    nav = []
    if current_idx > 0:
        nav.append(InlineKeyboardButton(text="◀️ السابق", callback_data="exam_prev"))
    if current_idx < total - 1:
        nav.append(InlineKeyboardButton(text="التالي ▶️", callback_data="exam_next"))
    if nav:
        rows.append(nav)

    rows.append([InlineKeyboardButton(
        text=f"🏁 إنهاء وإظهار النتيجة ({answered_count}/{total})",
        callback_data="exam_submit"
    )])
    # Bouton pour finir l'examen pendant la réflexion
    rows.append([InlineKeyboardButton(text="🚪 أنهي الاختبار", callback_data="end_exam")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


def next_question_kb(q_id: int = None, has_explanation: bool = False, has_prev: bool = False):
    rows = []
    if q_id:
        if has_explanation:
            rows.append([InlineKeyboardButton(text="🔍 شرح الأستاذ", callback_data=f"show_expl_{q_id}")])
        rows.append([InlineKeyboardButton(text="⚠️ إبلاغ عن خطأ في السؤال", callback_data=f"report_q_id:{q_id}")])
    
    nav_row = []
    if has_prev:
        nav_row.append(InlineKeyboardButton(text="◀️ السابق", callback_data="prev_q"))
    nav_row.append(InlineKeyboardButton(text="السؤال التالي ▶️",  callback_data="next_q"))
    
    rows.append(nav_row)
    rows.append([InlineKeyboardButton(text="🚪 أنهي الاختبار",  callback_data="end_exam")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


def explanation_tab_kb(q_id: int = None, active_tab: str = "pedago", has_prev: bool = False, youtube_url: str = None, has_citation: bool = True, has_mind_map: bool = False):
    rows = []
    
    # Bouton unique et stable de bascule entre les deux onglets (seulement s'il y a une citation)
    if has_citation:
        if active_tab == "quote":
            toggle_label = "💡 الانتقال إلى الشرح التربوي"
            callback_val = f"show_expl_{q_id}_pedago"
        else:
            toggle_label = "📖 الانتقال إلى قول الشيخ"
            callback_val = f"show_expl_{q_id}_quote"
            
        rows.append([InlineKeyboardButton(text=toggle_label, callback_data=callback_val)])
    
    # Bouton YouTube si URL présente
    if youtube_url:
        rows.append([InlineKeyboardButton(text="🎥 مشاهدة على يوتيوب (YouTube)", url=youtube_url)])
        
    # Bouton Mind map si disponible
    if has_mind_map and q_id:
        rows.append([InlineKeyboardButton(text="🗺️ الخريطة الذهنية للدرس", callback_data=f"view_map_quiz_{q_id}")])
        
    if q_id:
        rows.append([InlineKeyboardButton(text="❓ عرض السؤال والجواب", callback_data=f"show_quest_{q_id}")])
        rows.append([InlineKeyboardButton(text="⚠️ إبلاغ عن خطأ في السؤال", callback_data=f"report_q_id:{q_id}")])
    
    nav_row = []
    if has_prev:
        nav_row.append(InlineKeyboardButton(text="◀️ السابق", callback_data="prev_q"))
    nav_row.append(InlineKeyboardButton(text="السؤال التالي ▶️",  callback_data="next_q"))
    
    rows.append(nav_row)
    rows.append([InlineKeyboardButton(text="🚪 أنهي الاختبار",  callback_data="end_exam")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


