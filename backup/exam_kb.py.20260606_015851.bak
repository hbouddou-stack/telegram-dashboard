    buttons.extend([
        [InlineKeyboardButton(text="📚 اختيار حسب الموضوع (قائمة)",    callback_data=f"etopic_multi_{subject}")],
        [InlineKeyboardButton(text="🔢 اختيار حسب رقم الدرس (شبكة)",   callback_data=f"enum_multi_{subject}")],
        [InlineKeyboardButton(text="🎓 المادة كاملة (كل الدروس)",     callback_data=f"escope_all_{subject}")],
        [InlineKeyboardButton(text="رجوع ▶️",                    callback_data="menu_exams")],
    ])
    return InlineKeyboardMarkup(inline_keyboard=buttons)


