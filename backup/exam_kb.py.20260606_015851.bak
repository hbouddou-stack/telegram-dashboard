# ── قائمة الدروس ─────────────────────────────────────────────────────────────

def courses_kb(subject: str, mastery_data: dict = None, prefix: str = "ecourse", back_cb: str = None, user_hidden_sessions: list = None, new_courses: set = None):
    mastery_data = mastery_data or {}
    user_hidden_sessions = user_hidden_sessions or []
    new_courses = new_courses or set()
    admin_hidden = session_state.get_hidden()
    courses = COURSES_BY_SUBJECT.get(subject, [])
    
    rows = []
    # Header
    rows.append([
        InlineKeyboardButton(text="⚙️ الحالة", callback_data="none"),
        InlineKeyboardButton(text="📚 الدرس", callback_data="none")
    ])
    
    for c in courses:
        cn = c["course_number"]
        course_title = c.get("name", "")
        display_name = f"الدرس {cn} : {course_title}" if course_title else f"الدرس {cn}"
        if cn in new_courses:
            display_name = f"🔥 {display_name}"
        
        if cn in admin_hidden or str(cn) in user_hidden_sessions:
            continue
            
        score = mastery_data.get(cn)
        icon = "⚪"
        if score is not None:
            if score <= 2: icon = "🔴"
            elif score <= 4: icon = "🟡"
            else: icon = "🟢"
        
        identifier = cn
        cb = f"{prefix}_{subject}_{identifier}"
        
        rows.append([
            InlineKeyboardButton(text=icon, callback_data=cb),
            InlineKeyboardButton(text=display_name, callback_data=cb)
        ])
        
    back = back_cb or f"exam_subj_{subject}"
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=back)])
    return InlineKeyboardMarkup(inline_keyboard=rows)



# ── نطاق الدروس ──────────────────────────────────────────────────────────────

def courses_range_from_kb(subject: str, back_cb: str = None, user_hidden_sessions: list = None):
    if user_hidden_sessions is None:
        user_hidden_sessions = []
    admin_hidden = session_state.get_hidden()
    courses = COURSES_BY_SUBJECT.get(subject, [])
    numbers = [c["course_number"] for c in courses if c["course_number"] not in admin_hidden and str(c["course_number"]) not in user_hidden_sessions]
    rows = _number_grid(numbers, f"erange_from_{subject}")
    back = back_cb or f"exam_subj_{subject}"
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=back)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


def courses_range_to_kb(subject: str, from_cn: int):
    courses = COURSES_BY_SUBJECT.get(subject, [])
    rows = []
    row  = []
    for c in courses:
        n = c["course_number"]
        if n >= from_cn:
            label = f"✅ {n}" if n == from_cn else str(n)
            row.append(InlineKeyboardButton(
                text=label,
                callback_data=f"erange_to_{subject}_{from_cn}_{n}"
            ))
            if len(row) == 5:
                rows.append(row)
                row = []
    if row:
        rows.append(row)
    rows.append([InlineKeyboardButton(text="رجوع ▶️", callback_data=f"escope_range_{subject}")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


